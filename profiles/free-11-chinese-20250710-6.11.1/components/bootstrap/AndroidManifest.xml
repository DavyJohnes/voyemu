<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.voyemu" android:sharedUserId="android.uid.system">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="30" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <application android:label="EmulatorBootstrap" android:allowBackup="false">
        <uses-library android:name="QGAPI" android:required="true" />
        <service android:name="com.voyemu.output.SecondScreenService" android:exported="true" />
        <receiver android:name="com.voyemu.output.BootReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
