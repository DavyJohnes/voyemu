# Voyemu text rules. Editors read EditorConfig only from a file named .editorconfig;
# src/dev/checks/EditorConfigCheck.java enforces end_of_line, insert_final_newline,
# trim_trailing_whitespace and indent_style from this file for tracked files.
# Section paths are relative to the project root.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Line length for code; Markdown keeps one line per paragraph.
[*.{c,h,inc,cpp,hpp,mm,S,java,sh,cmake}]
max_line_length = 100

[CMakeLists.txt]
max_line_length = 100

[*.{json,md}]
indent_size = 2

# Markdown may end a line with two spaces for a hard break.
[*.md]
trim_trailing_whitespace = false

# Patch context lines keep the whitespace of the patched file.
[*.{patch,diff}]
trim_trailing_whitespace = false
indent_style = unset

# Pinned third-party bytes: SHA-256 pins must not change.
[src/app/third_party/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
max_line_length = unset

# Byte-pinned license texts and OEM fixtures.
[{src/licenses/**,src/app/prepare/testdata/**,src/app/ui/testdata/fonts/*-OFL.txt}]
insert_final_newline = unset
trim_trailing_whitespace = unset

# Byte-pinned inputs without a final newline; normalize only together with their pins.
[{src/app/graphics/generator/uniform_names.json,profiles/free-09-chinese-20221230-nxp-rc45/patches/nxp-launcher-display-routing.json}]
insert_final_newline = unset

# Java formatting hints for IntelliJ.
[*.java]
ij_java_align_multiline_parameters = false
ij_java_align_multiline_parameters_in_calls = false
ij_java_call_parameters_wrap = normal
ij_java_method_parameters_wrap = normal
ij_java_binary_operation_wrap = normal
ij_java_assignment_wrap = normal
ij_java_ternary_operation_wrap = normal
ij_java_imports_layout = java.**,|,javax.**,|,android.**,|,androidx.**,|,com.**,|,org.**,|,*,|,$*
ij_java_use_single_class_imports = true
ij_java_use_fq_class_names = false
ij_java_brace_style = end_of_line
ij_java_class_brace_style = end_of_line
ij_java_method_brace_style = end_of_line
ij_java_space_before_method_parentheses = false
ij_java_space_before_if_parentheses = true
ij_java_space_before_for_parentheses = true
ij_java_space_before_while_parentheses = true
