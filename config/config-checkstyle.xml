<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- Voyemu host and guest Java structure, correctness and size rules; run by src/dev/format/format.cmake
     after google-java-format, which owns all layout: whitespace, brace placement, line length,
     imports order, modifier order, annotation placement and file endings. -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Tests assert rejections and hand thread failures back, so they catch broad types. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="IllegalCatch"/>
        <property name="files" value="[/\\]src[/\\]prepare[/\\]test[/\\]"/>
    </module>

    <!-- Compile-only mirrors of several services.jar classes with their javac synthetic accessors. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="OuterTypeFilename|MethodName"/>
        <property name="files" value="[/\\](Api30FrameworkSignatures|Contracts)\.java$"/>
    </module>

    <!-- Compile-only declarations repeat the names and parameter lists of the OEM members they
         declare, constant interfaces included. -->
    <module name="SuppressionSingleFilter">
        <property name="checks"
                  value="MethodName|MemberName|StaticVariableName|ParameterNumber|InterfaceIsType"/>
        <property name="files" value="[/\\]src[/\\]compile-only[/\\]"/>
    </module>

    <!-- A pure SHA-256 pin table captured from the pinned OEM input, without logic. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="FileLength"/>
        <property name="files" value="[/\\]AudioPolicyPins\.java$"/>
    </module>

    <!-- A file longer than this splits into cohesive classes; the limit counts the blank lines
         that separate statements. -->
    <module name="FileLength">
        <property name="max" value="3072"/>
    </module>

    <module name="TreeWalker">
        <!-- A verified false positive is allowed only by a reason comment on the first line of the
             flagged block: "// checkstyle-allow <Check>: <reason>". -->
        <module name="SuppressWithNearbyCommentFilter">
            <property name="commentFormat" value="checkstyle-allow (\w+): \S.*"/>
            <property name="checkFormat" value="$1"/>
            <property name="influenceFormat" value="-1"/>
        </module>

        <!-- Naming -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="MemberName"/>
        <module name="StaticVariableName"/>
        <module name="ConstantName"/>
        <module name="PackageName"/>
        <module name="OuterTypeFilename"/>

        <!-- Structure: every control body is braced, every import names one type. -->
        <module name="NeedBraces"/>
        <module name="AvoidStarImport"/>

        <!-- Correctness -->
        <module name="StringLiteralEquality"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="EmptyBlock"/>
        <module name="EmptyStatement"/>
        <module name="MissingSwitchDefault"/>
        <module name="DefaultComesLast"/>
        <module name="FallThrough"/>
        <module name="UnusedImports"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <!-- A braced case body scopes its locals. -->
        <module name="AvoidNestedBlocks">
            <property name="allowInSwitchCase" value="true"/>
        </module>
        <module name="RedundantModifier"/>
        <module name="FinalClass"/>
        <module name="InterfaceIsType"/>
        <module name="IllegalInstantiation">
            <property name="classes" value="java.lang.Boolean,java.lang.Integer,java.lang.Long,java.lang.Short,java.lang.Byte,java.lang.Float,java.lang.Double"/>
        </module>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="java.lang.Exception,java.lang.Throwable,java.lang.RuntimeException"/>
        </module>

        <!-- Complexity and size -->
        <!-- McCabe: above 20 decision points a method is high risk; a flat dispatch switch counts once. -->
        <module name="CyclomaticComplexity">
            <property name="max" value="20"/>
            <property name="switchBlockAsSingleDecisionPoint" value="true"/>
        </module>
        <!-- About ten independent sequential decisions. -->
        <module name="NPathComplexity">
            <property name="max" value="1000"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="150"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="7"/>
            <property name="ignoreOverriddenMethods" value="true"/>
        </module>
    </module>
</module>
