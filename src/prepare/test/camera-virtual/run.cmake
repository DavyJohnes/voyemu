get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/tmp/camera-virtual-${TOKEN}")
file(MAKE_DIRECTORY "${WORK}")
file(GLOB_RECURSE TEST_SOURCES "${CMAKE_CURRENT_LIST_DIR}/*.java")
execute_process(COMMAND "${JAVAC}" -J-Xmx128m --release 25 -d "${WORK}" ${TEST_SOURCES} "${ROOT}/profiles/free-11-chinese-20260731-7.3.1/patches/api30-camera-virtual/src/com/voyemu/camera/BackCameraProbe.java" TIMEOUT 30 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "camera test compile: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
execute_process(COMMAND "${JAVA}" -Xmx128m -cp "${WORK}" com.voyemu.camera.BackCameraProbeTest TIMEOUT 15 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
file(REMOVE_RECURSE "${WORK}")
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "camera test: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
