get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/tmp/record-policy-${TOKEN}")
file(MAKE_DIRECTORY "${WORK}")
file(GLOB_RECURSE TEST_SOURCES "${CMAKE_CURRENT_LIST_DIR}/*.java")
execute_process(COMMAND "${JAVAC}" -J-Xmx128m --release 25 -d "${WORK}" ${TEST_SOURCES} "${ROOT}/src/guest/android/oem/audio/OemAudioPolicy.java" "${ROOT}/src/guest/android/oem/audio/OemAudioPolicyUnavailable.java" TIMEOUT 30 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
  message(FATAL_ERROR "record test compilation: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
execute_process(COMMAND "${JAVA}" -Xmx128m -cp "${WORK}" com.voyemu.oem.audio.CapturePolicyTest TIMEOUT 15 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
file(REMOVE_RECURSE "${WORK}")
if(NOT RESULT EQUAL 0)
  message(FATAL_ERROR "record test: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
message(STATUS "${OUTPUT}")
