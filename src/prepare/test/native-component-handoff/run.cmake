cmake_minimum_required(VERSION 3.29)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(WORK "${ROOT}/.local/build/jobs/prepare-java-native-component-${token}")
include("${ROOT}/src/prepare/test/jdk.cmake")
if(NOT IS_ABSOLUTE "${NATIVE_PRODUCER}" OR NOT EXISTS "${NATIVE_PRODUCER}")
    message(FATAL_ERROR "Built native_component_test required")
endif()
# Preflight every input before shared dependency helper: missing prerequisites fail, never skip.
file(READ "${ROOT}/src/prepare/libraries.json" libraries)
string(JSON library_count LENGTH "${libraries}")
math(EXPR library_last "${library_count}-1")
foreach(index RANGE ${library_last})
    string(JSON name GET "${libraries}" ${index} filename)
    if(NOT EXISTS "${ROOT}/.local/toolchains/java/libraries/${name}" OR IS_SYMLINK "${ROOT}/.local/toolchains/java/libraries/${name}")
        message(FATAL_ERROR "Required Java library missing: ${name}")
    endif()
endforeach()
include("${ROOT}/src/prepare/test/java_source_dependencies.cmake")
if(EXISTS "${WORK}" OR IS_SYMLINK "${WORK}")
    message(FATAL_ERROR "Fresh owned WORK required")
endif()
file(MAKE_DIRECTORY "${WORK}/classes")
# The production installer downloads every pinned native component of the profile, or builds it from
# the recipe with the pinned NDK while its release asset is not published, and writes the handoff.
execute_process(COMMAND "${NATIVE_PRODUCER}" --handoff "${ROOT}" free-09-chinese-20260106-6.0.3 "${WORK}/handoff.json"
    WORKING_DIRECTORY "${ROOT}" TIMEOUT 600 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${WORK}/producer.log" "${out}${err}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Native component installation failed: ${result}; ${out}${err}")
endif()
execute_process(COMMAND "${JAVAC}" -J-Xmx512m -J-XX:ActiveProcessorCount=1 --release 25 -proc:none -encoding UTF-8
    -cp "${JAVA_SOURCE_CLASSPATH}" -sourcepath "${ROOT}/src/prepare/java${CP_SEPARATOR}${ROOT}/src/prepare/test/java"
    -d "${WORK}/classes" "${ROOT}/src/prepare/test/java/com/voyemu/prepare/NativeComponentHandoffTest.java"
    WORKING_DIRECTORY "${ROOT}" TIMEOUT 60 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${WORK}/compile.log" "${out}${err}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Native handoff Java compilation failed: ${result}; ${out}${err}")
endif()
execute_process(COMMAND "${JAVA}" -Xmx512m -XX:ActiveProcessorCount=1 -cp "${WORK}/classes${CP_SEPARATOR}${JAVA_SOURCE_CLASSPATH}"
    com.voyemu.prepare.NativeComponentHandoffTest "${ROOT}" "${WORK}" "${WORK}/handoff.json"
    WORKING_DIRECTORY "${ROOT}" TIMEOUT 60 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${WORK}/run.log" "${out}${err}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Native component handoff failed: ${result}; ${out}${err}")
endif()
file(READ "${WORK}/handoff.json" handoff)
string(JSON handoff_count LENGTH "${handoff}")
math(EXPR handoff_last "${handoff_count}-1")
foreach(index RANGE ${handoff_last})
    string(JSON name MEMBER "${handoff}" ${index})
    string(JSON receipt GET "${handoff}" "${name}" receipt)
    get_filename_component(directory "${receipt}" DIRECTORY)
    file(REMOVE_RECURSE "${directory}")
endforeach()
file(REMOVE_RECURSE "${WORK}")
if(EXISTS "${WORK}" OR IS_SYMLINK "${WORK}")
    message(FATAL_ERROR "Owned WORK cleanup failed: ${WORK}")
endif()
message(STATUS "Native component handoff PASS")
