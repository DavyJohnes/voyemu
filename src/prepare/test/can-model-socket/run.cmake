cmake_minimum_required(VERSION 3.22)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/tmp/can-model-socket-${TOKEN}")
file(MAKE_DIRECTORY "${WORK}")
file(GLOB_RECURSE FIXTURES "${CMAKE_CURRENT_LIST_DIR}/*.java")
set(CLIENT "${ROOT}/profiles/common/components/canbus/src/com/qinggan/canbus/service/CanModelClient.java")
execute_process(COMMAND "${JAVAC}" -J-Xmx128m --release 25 -d "${WORK}" ${FIXTURES} "${CLIENT}" TIMEOUT 30 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "CAN socket compilation: ${RESULT} ${OUTPUT} ${ERROR}")
endif()
execute_process(COMMAND "${JAVA}" -Xmx128m -cp "${WORK}" CanModelClientContractTest TIMEOUT 15 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
file(REMOVE_RECURSE "${WORK}")
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "CAN socket runtime: ${RESULT} ${OUTPUT} ${ERROR}")
endif()
message(STATUS "${OUTPUT}")
