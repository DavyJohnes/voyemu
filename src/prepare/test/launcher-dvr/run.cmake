execute_process(COMMAND "${JAVAC}" -J-Xmx128m --release 25 -d "${WORK}" ${TEST_SOURCES} "${CAMERA_STUB}/graphics/ImageFormat.java" "${CAMERA_STUB}/hardware/camera2/CameraManager.java" "${CAMERA_STUB}/hardware/camera2/CameraCharacteristics.java" "${CAMERA_STUB}/hardware/camera2/params/StreamConfigurationMap.java" "${ROOT}/profiles/free-11-chinese-20260731-7.3.1/patches/api30-launcher-dvr/src/com/voyemu/launcher/DvrAvailability.java" TIMEOUT 30 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "Launcher DVR test compile: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
execute_process(COMMAND "${JAVA}" -Xmx128m -cp "${WORK}" com.voyemu.launcher.DvrAvailabilityTest TIMEOUT 15 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
