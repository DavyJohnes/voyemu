cmake_minimum_required(VERSION 3.29)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../java_source_dependencies.cmake")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef TOKEN)
set(JOB "${ROOT}/.local/build/jobs/passion-phone-test-${TOKEN}")
set(WORK "${JOB}/work")
set(LOG "${JOB}/check.log")
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${LOG}" "Passion phone canonical source checks\n")
function(check LABEL)
    execute_process(COMMAND ${ARGN} TIMEOUT 90 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    file(APPEND "${LOG}" "${LABEL}\n${OUTPUT}${ERROR}\n")
    if(NOT RESULT EQUAL 0)
        message(FATAL_ERROR "${LABEL}: ${OUTPUT}${ERROR}; retained ${WORK}; log ${LOG}")
    endif()
    message(STATUS "${LABEL}: ${OUTPUT}")
endfunction()
set(PROFILE "${ROOT}/profiles/passion-11-russian-20260403-2.1.4.80")
set(SOURCE "${PROFILE}/components/phone/src")
set(TEST "${PROFILE}/components/phone/test")
set(COMPILE "${JAVAC}" -J-XX:ActiveProcessorCount=1 -J-Xmx512m -encoding UTF-8)
set(RUN "${JAVA}" -XX:ActiveProcessorCount=1 -Xmx512m)
check("model compile" ${COMPILE} --release 8 -d "${WORK}/model"
    "${SOURCE}/com/voyemu/passion/phone/PassionSyntheticPhone.java" "${TEST}/PassionSyntheticPhoneTest.java")
