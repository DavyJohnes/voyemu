# Compile production sources against normal pinned build inputs, never a cached helper.
file(READ "${ROOT}/src/prepare/libraries.json" LIBRARY_SPEC)
string(JSON LIBRARY_COUNT LENGTH "${LIBRARY_SPEC}")
math(EXPR LIBRARY_LAST "${LIBRARY_COUNT}-1")
set(JAVA_LIBRARIES "")
foreach(INDEX RANGE ${LIBRARY_LAST})
    string(JSON NAME GET "${LIBRARY_SPEC}" ${INDEX} filename)
    string(JSON EXPECTED GET "${LIBRARY_SPEC}" ${INDEX} sha256)
    set(LIBRARY "${ROOT}/.local/toolchains/java/libraries/${NAME}")
    if(NOT EXISTS "${LIBRARY}" OR IS_SYMLINK "${LIBRARY}")
        message(STATUS "Pinned Java build dependency required: ${NAME}; run documented deps preparation")
        cmake_language(EXIT 77)
    endif()
    file(SHA256 "${LIBRARY}" ACTUAL)
    if(NOT ACTUAL STREQUAL EXPECTED)
        message(FATAL_ERROR "Java build dependency pin differs: ${NAME}")
    endif()
    list(APPEND JAVA_LIBRARIES "${LIBRARY}")
endforeach()
file(READ "${ROOT}/src/prepare/toolchain.json" TOOL_SPEC)
foreach(NAME d8 apksigner)
    string(JSON EXPECTED GET "${TOOL_SPEC}" libraries ${NAME} sha256)
    set(LIBRARY "${ROOT}/.local/toolchains/java-sdk/build-tools/36.1.0/lib/${NAME}.jar")
    if(NOT EXISTS "${LIBRARY}")
        set(LIBRARY "${ROOT}/.local/toolchains/native-sdk/build-tools/36.1.0/lib/${NAME}.jar")
    endif()
    if(NOT EXISTS "${LIBRARY}" OR IS_SYMLINK "${LIBRARY}")
        message(STATUS "Pinned Java build tool required: ${NAME}; run documented deps preparation")
        cmake_language(EXIT 77)
    endif()
    file(SHA256 "${LIBRARY}" ACTUAL)
    if(NOT ACTUAL STREQUAL EXPECTED)
        message(FATAL_ERROR "Java build tool pin differs: ${NAME}")
    endif()
    list(APPEND JAVA_LIBRARIES "${LIBRARY}")
endforeach()
if(WIN32)
    set(CP_SEPARATOR ";")
else()
    set(CP_SEPARATOR ":")
endif()
list(JOIN JAVA_LIBRARIES "${CP_SEPARATOR}" JAVA_SOURCE_CLASSPATH)
