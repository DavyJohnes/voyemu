get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/tmp/own-context-${TOKEN}")
file(MAKE_DIRECTORY "${WORK}")
file(GLOB_RECURSE SOURCES "${CMAKE_CURRENT_LIST_DIR}/*.java")
if(NOT DEFINED OWN_CONTEXT_SOURCE)
 set(OWN_CONTEXT_SOURCE "${ROOT}/profiles/free-11-chinese-20260731-7.3.1/patches/original-navi-egl/src/com/voyemu/navi/OwnContext.java")
endif()
execute_process(COMMAND "${JAVAC}" --release 25 -d "${WORK}" ${SOURCES} "${OWN_CONTEXT_SOURCE}" RESULT_VARIABLE RESULT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "own context compile: ${ERROR}")
endif()
execute_process(COMMAND "${JAVA}" -cp "${WORK}" com.voyemu.navi.OwnContextTest RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
file(REMOVE_RECURSE "${WORK}")
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "own context: ${OUTPUT}${ERROR}")
endif()
message(STATUS "${OUTPUT}")
