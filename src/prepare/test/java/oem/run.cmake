cmake_minimum_required(VERSION 3.29)
# OEM-input preparation checks: each case runs only when its imported profile originals exist.
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../java_source_dependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/cases.cmake")
if(NOT DEFINED GROUP OR NOT DEFINED CASES_${GROUP})
    message(FATAL_ERROR "Unknown OEM case group: ${GROUP}")
endif()
set(PLATFORM "${ROOT}/.local/toolchains/java-sdk/platforms/android-34/android.jar")
if(NOT EXISTS "${PLATFORM}")
    message(STATUS "Prepared SDK required: ${PLATFORM}")
    cmake_language(EXIT 77)
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/jobs/prepare-java-oem-${GROUP}-${TOKEN}")
# Tokens: ROOT, PLATFORM, WORK (fresh directory), NEW (absent path), ORIGINAL:<profile>/<file>,
# ANDROID:<profile>/<system|system_ext>/<path> (file of the pinned Android image of the profile;
# system_ext exists only in the logical partitions of API 30),
# NEEDS:<profile> (required originals, not passed). Other tokens pass unchanged.
set(RUNNABLE)
set(SKIPPED)
set(ANDROID_KEYS)
foreach(CASE IN LISTS CASES_${GROUP})
    separate_arguments(TOKENS UNIX_COMMAND "${CASE}")
    list(POP_FRONT TOKENS NAME)
    set(ARGUMENTS)
    set(MISSING)
    foreach(TOKEN IN LISTS TOKENS)
        if(TOKEN STREQUAL "ROOT")
            list(APPEND ARGUMENTS "${ROOT}")
        elseif(TOKEN STREQUAL "PLATFORM")
            list(APPEND ARGUMENTS "${PLATFORM}")
        elseif(TOKEN STREQUAL "WORK")
            list(APPEND ARGUMENTS "${WORK}/${NAME}/work")
            list(APPEND CREATE_${NAME} "${WORK}/${NAME}/work")
        elseif(TOKEN STREQUAL "NEW")
            list(APPEND ARGUMENTS "${WORK}/${NAME}/new")
        elseif(TOKEN MATCHES "^ORIGINAL:([^/]+)/(.+)$")
            set(FILE "${ROOT}/.local/profiles/${CMAKE_MATCH_1}/originals/${CMAKE_MATCH_2}")
            list(APPEND ARGUMENTS "${FILE}")
            if(NOT EXISTS "${FILE}")
                list(APPEND MISSING "${FILE}")
            endif()
        elseif(TOKEN MATCHES "^ANDROID:([^/]+)/(system|system_ext)(/.+)$")
            # The partition comes from the system.img that fetch keeps in the clean base or the image
            # archive; it is extracted after the case selection, once per profile and partition.
            set(KEY "${CMAKE_MATCH_1}/${CMAKE_MATCH_2}")
            set(MEMBER "${CMAKE_MATCH_3}")
            file(READ "${ROOT}/profiles/${CMAKE_MATCH_1}/profile.json" DEFINITION)
            string(JSON ARCHIVE_SHA GET "${DEFINITION}" android sha256)
            string(JSON IMAGE_SHA GET "${DEFINITION}" android clean_base images system.img)
            string(JSON ARCHIVE_URL GET "${DEFINITION}" android url)
            string(JSON PACKAGE GET "${DEFINITION}" android package)
            get_filename_component(ARCHIVE_NAME "${ARCHIVE_URL}" NAME)
            set(SOURCE)
            foreach(CANDIDATE IN ITEMS
                    "${ROOT}/.local/profiles/common/android-base/${ARCHIVE_SHA}/system.img"
                    "${ROOT}/.local/toolchains/downloads/archives/${ARCHIVE_NAME}"
                    "${ROOT}/.local/toolchains/downloads/native/${ARCHIVE_SHA}.blob")
                if(NOT SOURCE AND EXISTS "${CANDIDATE}")
                    set(SOURCE "${CANDIDATE}")
                endif()
            endforeach()
            if(SOURCE)
                list(APPEND ARGUMENTS "${WORK}/android/${KEY}${MEMBER}")
                list(APPEND ANDROID_CASE_${NAME} "${KEY}")
                set(ANDROID_SOURCE_${KEY} "${SOURCE}")
                set(ANDROID_SHA_${KEY} "${IMAGE_SHA}")
                # API 30 images hold the partitions in a super image, older ones are one ext4 image.
                if(PACKAGE MATCHES ";android-30;")
                    set(ANDROID_MODE_${KEY} --extract-logical)
                else()
                    set(ANDROID_MODE_${KEY} --extract-batch)
                endif()
                list(APPEND ANDROID_MEMBERS_${KEY} "${MEMBER}")
            else()
                list(APPEND MISSING "Android image ${ARCHIVE_NAME} of ${CMAKE_MATCH_1}")
            endif()
        elseif(TOKEN MATCHES "^NEEDS:(.+)$")
            if(NOT IS_DIRECTORY "${ROOT}/.local/profiles/${CMAKE_MATCH_1}/originals")
                list(APPEND MISSING "${ROOT}/.local/profiles/${CMAKE_MATCH_1}/originals")
            endif()
        else()
            list(APPEND ARGUMENTS "${TOKEN}")
        endif()
    endforeach()
    if(MISSING)
        list(APPEND SKIPPED "${NAME}")
        message(STATUS "${NAME}: skipped, OEM inputs absent: ${MISSING}")
    else()
        list(APPEND RUNNABLE "${NAME}")
        set(ARGS_${NAME} ${ARGUMENTS})
        list(APPEND ANDROID_KEYS ${ANDROID_CASE_${NAME}})
    endif()
endforeach()
if(NOT RUNNABLE)
    message(STATUS "OEM inputs required: ${SKIPPED}")
    cmake_language(EXIT 77)
endif()
file(MAKE_DIRECTORY "${WORK}/classes" "${WORK}/tmp")
list(REMOVE_DUPLICATES ANDROID_KEYS)
foreach(KEY IN LISTS ANDROID_KEYS)
    if(NOT EXT4_IMAGE)
        message(FATAL_ERROR "EXT4_IMAGE (ext4_image_test) required for ANDROID tokens")
    endif()
    # ext4_image_test runs the extraction of preparation: it checks system.img against its
    # clean_base pin and reads the logical partition or the whole ext4 image without mounting it;
    # its two passes over the 3 GiB image take minutes on a slow disk.
    set(IMAGE "${ANDROID_SOURCE_${KEY}}")
    if(NOT IMAGE MATCHES "/system\\.img$")
        file(ARCHIVE_EXTRACT INPUT "${IMAGE}" DESTINATION "${WORK}/android-archive" PATTERNS "*/system.img")
        file(GLOB IMAGE "${WORK}/android-archive/*/system.img")
    endif()
    list(REMOVE_DUPLICATES ANDROID_MEMBERS_${KEY})
    string(REGEX MATCH "[^/]+$" PARTITION "${KEY}")
    if(ANDROID_MODE_${KEY} STREQUAL "--extract-logical")
        set(MODE --extract-logical "${IMAGE}" "${ANDROID_SHA_${KEY}}" "${PARTITION}")
    else()
        set(MODE --extract-batch "${IMAGE}" "${ANDROID_SHA_${KEY}}")
    endif()
    execute_process(COMMAND "${EXT4_IMAGE}" ${MODE} "${WORK}/android/${KEY}" ${ANDROID_MEMBERS_${KEY}}
        TIMEOUT 1200 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    file(REMOVE_RECURSE "${WORK}/android-archive")
    if(NOT RESULT EQUAL 0)
        message(FATAL_ERROR "Android image extraction ${KEY}: ${RESULT}\n${OUTPUT}\n${ERROR}")
    endif()
endforeach()
set(SOURCES)
foreach(NAME IN LISTS RUNNABLE)
    list(APPEND SOURCES "${ROOT}/src/prepare/test/java/com/voyemu/prepare/${NAME}.java")
endforeach()
execute_process(COMMAND "${JAVAC}" -J-Xmx1g --release 25 -encoding UTF-8 -proc:none -nowarn
    -cp "${JAVA_SOURCE_CLASSPATH}" -sourcepath "${ROOT}/src/prepare/java${CP_SEPARATOR}${ROOT}/src/prepare/test/java"
    -d "${WORK}/classes" ${SOURCES}
    TIMEOUT 300 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "OEM ${GROUP} compilation: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
set(FAILED)
set(PASSED)
foreach(NAME IN LISTS RUNNABLE)
    if(DEFINED CREATE_${NAME})
        file(MAKE_DIRECTORY ${CREATE_${NAME}})
    endif()
    file(MAKE_DIRECTORY "${WORK}/${NAME}")
    execute_process(COMMAND "${JAVA}" -Xmx1g "-Djava.io.tmpdir=${WORK}/tmp"
        -cp "${WORK}/classes${CP_SEPARATOR}${JAVA_SOURCE_CLASSPATH}" "com.voyemu.prepare.${NAME}" ${ARGS_${NAME}}
        WORKING_DIRECTORY "${ROOT}" TIMEOUT 300 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    file(WRITE "${WORK}/${NAME}.log" "${OUTPUT}${ERROR}")
    if(RESULT EQUAL 0)
        list(APPEND PASSED "${NAME}")
        message(STATUS "${NAME}: passed")
    elseif(RESULT EQUAL 77)
        list(APPEND SKIPPED "${NAME}")
        message(STATUS "${NAME}: skipped, OEM inputs absent\n${OUTPUT}${ERROR}")
    else()
        message(STATUS "${NAME}: failed ${RESULT}\n${OUTPUT}\n${ERROR}")
        list(APPEND FAILED "${NAME}")
    endif()
endforeach()
if(FAILED)
    message(FATAL_ERROR "OEM ${GROUP} failures: ${FAILED}; diagnostics: ${WORK}")
endif()
file(REMOVE_RECURSE "${WORK}")
if(NOT PASSED)
    cmake_language(EXIT 77)
endif()
message(STATUS "OEM ${GROUP}: passed ${PASSED}; skipped ${SKIPPED}")
