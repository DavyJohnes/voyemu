cmake_minimum_required(VERSION 3.29)
# Exact imported Setting bytecode/manifest regressions; no helper APK/profile/guest build.
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
# The shared dependency helper can skip absent tools. This suite requires every input.
file(READ "${ROOT}/src/prepare/libraries.json" libraries)
string(JSON count LENGTH "${libraries}")
math(EXPR last "${count}-1")
foreach(index RANGE ${last})
    string(JSON name GET "${libraries}" ${index} filename)
    set(input "${ROOT}/.local/toolchains/java/libraries/${name}")
    if(NOT EXISTS "${input}" OR IS_SYMLINK "${input}")
        message(FATAL_ERROR "Required pinned library missing: ${input}")
    endif()
endforeach()
foreach(name d8 apksigner)
    set(input "${ROOT}/.local/toolchains/java-sdk/build-tools/36.1.0/lib/${name}.jar")
    if(NOT EXISTS "${input}")
        set(input "${ROOT}/.local/toolchains/native-sdk/build-tools/36.1.0/lib/${name}.jar")
    endif()
    if(NOT EXISTS "${input}" OR IS_SYMLINK "${input}")
        message(FATAL_ERROR "Required pinned build tool missing: ${input}")
    endif()
endforeach()
include("${ROOT}/src/prepare/test/java_source_dependencies.cmake")
set(ID "free-11-chinese-20260731-7.3.1")
set(PROFILE "${ROOT}/profiles/${ID}/profile.json")
file(READ "${PROFILE}" profile)
string(JSON filename GET "${profile}" original Setting file)
string(JSON expected GET "${profile}" original Setting sha256)
set(ORIGINAL "${ROOT}/.local/profiles/${ID}/originals/${filename}")
if(NOT EXISTS "${ORIGINAL}" OR IS_SYMLINK "${ORIGINAL}")
    message(FATAL_ERROR "Genuine readonly Setting.apk required: ${ORIGINAL}")
endif()
file(REAL_PATH "${ORIGINAL}" canonical)
if(NOT ORIGINAL STREQUAL canonical)
    message(FATAL_ERROR "Canonical genuine Setting.apk required: ${ORIGINAL}")
endif()
file(SHA256 "${ORIGINAL}" before)
if(NOT before STREQUAL expected)
    message(FATAL_ERROR "External Setting.apk pin differs")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(WORK "${ROOT}/.local/build/jobs/prepare-java-oem-settings-${token}")
if(EXISTS "${WORK}" OR IS_SYMLINK "${WORK}")
    message(FATAL_ERROR "Fresh owned WORK required: ${WORK}")
endif()
file(MAKE_DIRECTORY "${WORK}/classes" "${WORK}/tmp" "${WORK}/manifest")
file(WRITE "${WORK}/input-provenance.txt" "profile=${ID}\noriginal=${ORIGINAL}\noriginal_sha256=${before}\ndex_input=bounded readonly ZIP entry; no filesystem fixture\n")
set(TESTS "${ROOT}/src/prepare/test/java/com/voyemu/prepare")
set(SOUND_TEST "${TESTS}/SoundBalanceGuardTest.java")
set(PROVENANCE_INPUTS "${JAVA}" "${JAVAC}" "${PROFILE}" "${CMAKE_CURRENT_LIST_FILE}"
    "${SOUND_TEST}"
    "${ROOT}/src/prepare/test/java/com/voyemu/prepare/SettingsManifestTest.java"
    "${ROOT}/src/prepare/java/com/voyemu/prepare/SoundBalanceGuard.java"
    "${ROOT}/src/prepare/java/com/voyemu/prepare/SettingsManifest.java"
    "${ROOT}/src/prepare/java/com/voyemu/prepare/FrameworkDexMaterializer.java"
    "${ROOT}/src/prepare/java/com/voyemu/prepare/ManifestLibraries.java"
    "${ROOT}/src/prepare/java/com/voyemu/prepare/NativeCore.java" ${JAVA_LIBRARIES})
foreach(input IN LISTS PROVENANCE_INPUTS)
    file(SHA256 "${input}" sha)
    string(SHA256 key "${input}")
    set(BEFORE_${key} "${sha}")
    file(APPEND "${WORK}/provenance.sha256" "${sha}  ${input}\n")
endforeach()

execute_process(COMMAND "${JAVAC}" -J-Xmx512m -J-XX:ActiveProcessorCount=1 --release 25 -proc:none -encoding UTF-8
    -cp "${JAVA_SOURCE_CLASSPATH}" -sourcepath "${ROOT}/src/prepare/java${CP_SEPARATOR}${ROOT}/src/prepare/test/java"
    -d "${WORK}/classes" "${SOUND_TEST}" "${TESTS}/SettingsManifestTest.java"
    WORKING_DIRECTORY "${ROOT}" TIMEOUT 90 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${WORK}/compile.log" "${out}${err}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "OEM Settings compilation failed: ${result}; ${out}${err}")
endif()
set(ARGS_SoundBalanceGuardTest --apk "${ORIGINAL}")
set(ARGS_SettingsManifestTest "${ORIGINAL}" "${WORK}/manifest")
set(FAILED)
foreach(test SoundBalanceGuardTest SettingsManifestTest)
    execute_process(COMMAND "${JAVA}" -Xmx512m -XX:ActiveProcessorCount=1 -ea "-Djava.io.tmpdir=${WORK}/tmp"
        -cp "${WORK}/classes${CP_SEPARATOR}${JAVA_SOURCE_CLASSPATH}" "com.voyemu.prepare.${test}" ${ARGS_${test}}
        WORKING_DIRECTORY "${ROOT}" TIMEOUT 60 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${WORK}/${test}.log" "exit=${result}\n${out}${err}")
    if(NOT result EQUAL 0)
        list(APPEND FAILED "${test}:${result}")
    endif()
    message(STATUS "${test} exit=${result}: ${out}${err}")
endforeach()
file(SHA256 "${ORIGINAL}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Readonly OEM input/fixture changed")
endif()
foreach(input IN LISTS PROVENANCE_INPUTS)
    file(SHA256 "${input}" sha)
    string(SHA256 key "${input}")
    if(NOT sha STREQUAL "${BEFORE_${key}}")
        message(FATAL_ERROR "Test/source/toolchain input changed: ${input}")
    endif()
endforeach()
if(FAILED)
    message(FATAL_ERROR "OEM Settings failures ${FAILED}; diagnostics ${WORK}")
endif()
set(SUMMARY "${WORK}-summary")
if(NOT WORK STREQUAL "${ROOT}/.local/build/jobs/prepare-java-oem-settings-${token}"
        OR IS_SYMLINK "${WORK}" OR EXISTS "${SUMMARY}" OR IS_SYMLINK "${SUMMARY}")
    message(FATAL_ERROR "Owned success cleanup guard failed")
endif()
file(MAKE_DIRECTORY "${SUMMARY}")
file(GLOB logs "${WORK}/*.log" "${WORK}/*.txt")
file(COPY ${logs} DESTINATION "${SUMMARY}")
file(GLOB_RECURSE artifacts "${WORK}/*.class" "${WORK}/manifest/*")
foreach(artifact IN LISTS artifacts)
    file(SHA256 "${artifact}" sha)
    file(RELATIVE_PATH name "${WORK}" "${artifact}")
    file(APPEND "${SUMMARY}/artifacts.sha256" "${sha}  ${name}\n")
endforeach()
file(COPY "${WORK}/provenance.sha256" DESTINATION "${SUMMARY}")
file(WRITE "${SUMMARY}/summary.txt" "exit=0\nprofile=${ID}\nsound_balance_cases=1\nsettings_manifest_cases=1\nwork=${WORK}\n")
file(REMOVE_RECURSE "${WORK}")
if(EXISTS "${WORK}" OR IS_SYMLINK "${WORK}")
    message(FATAL_ERROR "Owned WORK cleanup failed")
endif()
message(STATUS "OEM Settings PASS; summary ${SUMMARY}")
