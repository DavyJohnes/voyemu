cmake_minimum_required(VERSION 3.29)
# Runs every *Test class of one guest Java unit on the host JVM.
# UNIT=android-api compiles src/guest/android/api against the pinned android.jar; the tested classes
# never call its stubs. UNIT=view-observation compiles the A9 view-observation component with the JVM
# Android doubles in its host-tests directory.
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
if(UNIT STREQUAL "android-api")
    set(PLATFORM "${ROOT}/.local/toolchains/java-sdk/platforms/android-34/android.jar")
    if(NOT EXISTS "${PLATFORM}")
        message(STATUS "Prepared SDK required: ${PLATFORM}")
        cmake_language(EXIT 77)
    endif()
    set(CLASSPATH "${PLATFORM}")
    file(GLOB SOURCES "${ROOT}/src/guest/android/api/*.java")
    file(GLOB TESTS "${ROOT}/src/guest/android/api/*Test.java")
elseif(UNIT STREQUAL "view-observation")
    set(COMPONENT "${ROOT}/profiles/free-09-chinese-20260106-6.0.3/components/view-observation")
    set(CLASSPATH)
    file(GLOB_RECURSE SOURCES "${COMPONENT}/src/*.java" "${COMPONENT}/host-tests/*.java")
    file(GLOB_RECURSE TESTS "${COMPONENT}/host-tests/*Test.java")
else()
    message(FATAL_ERROR "UNIT must be android-api or view-observation")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/tmp/guest-java-${UNIT}-${TOKEN}")
file(MAKE_DIRECTORY "${WORK}")
set(OPTIONS)
if(CLASSPATH)
    set(OPTIONS -cp "${CLASSPATH}")
endif()
execute_process(COMMAND "${JAVAC}" -J-Xmx512m --release 8 -nowarn -encoding UTF-8 -proc:none ${OPTIONS} -d "${WORK}" ${SOURCES}
    TIMEOUT 120 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "Guest ${UNIT} compilation: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
if(WIN32)
    set(SEPARATOR ";")
else()
    set(SEPARATOR ":")
endif()
list(PREPEND CLASSPATH "${WORK}")
list(JOIN CLASSPATH "${SEPARATOR}" CLASSPATH)
set(FAILED)
foreach(TEST IN LISTS TESTS)
    file(STRINGS "${TEST}" PACKAGE REGEX "^package [a-z.]+" LIMIT_COUNT 1)
    string(REGEX MATCH "^package ([a-z.]+)" PACKAGE "${PACKAGE}")
    set(PACKAGE "${CMAKE_MATCH_1}")
    get_filename_component(NAME "${TEST}" NAME_WE)
    execute_process(COMMAND "${JAVA}" -Xmx256m -cp "${CLASSPATH}" "${PACKAGE}.${NAME}"
        TIMEOUT 60 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    if(RESULT EQUAL 0)
        message(STATUS "${NAME}: ${OUTPUT}")
    else()
        message(STATUS "${NAME}: failed ${RESULT}\n${OUTPUT}${ERROR}")
        list(APPEND FAILED "${NAME}")
    endif()
endforeach()
if(FAILED)
    message(FATAL_ERROR "Guest ${UNIT} failures: ${FAILED}; diagnostics: ${WORK}")
endif()
file(REMOVE_RECURSE "${WORK}")
