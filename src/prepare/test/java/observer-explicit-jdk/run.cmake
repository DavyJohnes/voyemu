cmake_minimum_required(VERSION 3.29)
# Offline deps regression: pinned JDK25+ and prepared Java SDK required; --ensure reuses the helper of
# the current sources or builds it offline, so the first run after a source change needs no extra step.
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../../.." ABSOLUTE)
foreach(REQUIRED IN ITEMS PROFILE_BUILD_TEST JAVA_TOOLCHAIN_TEST JDK)
    if(NOT IS_ABSOLUTE "${${REQUIRED}}" OR NOT EXISTS "${${REQUIRED}}")
        message(FATAL_ERROR "${REQUIRED} must name an installed absolute input")
    endif()
endforeach()
execute_process(COMMAND "${JAVA_TOOLCHAIN_TEST}" --ensure "${ROOT}" "${JDK}" offline
    TIMEOUT 180 RESULT_VARIABLE RESULT OUTPUT_VARIABLE TOOLS ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "Prepared offline Java toolchain required: ${RESULT}\n${TOOLS}${ERROR}")
endif()
string(JSON FINGERPRINT GET "${TOOLS}" fingerprint)
set(HELPER "${ROOT}/.local/toolchains/java-helper/${FINGERPRINT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/tmp/observer-explicit-jdk-${TOKEN}")
set(PROFILE free-09-chinese-20221230-nxp-rc45)
file(GLOB_RECURSE SOURCES RELATIVE "${ROOT}" "${ROOT}/src/prepare/java/*.java")
file(GLOB OBSERVER RELATIVE "${ROOT}" "${ROOT}/src/guest/android/api/*.java")
list(APPEND SOURCES ${OBSERVER}
    src/prepare/JavaHelperBuild.java src/prepare/libraries.json src/prepare/toolchain.json
    src/app/toolchain.json src/prepare/test/fixtures/com/voyemu/prepare/fixture/BuildMarker.java
    src/guest/android/oem/audio/OemAudioPolicy.java
    src/guest/android/oem/audio/OemAudioPolicyUnavailable.java "profiles/${PROFILE}/profile.json")
foreach(RELATIVE IN LISTS SOURCES)
    get_filename_component(PARENT "${WORK}/${RELATIVE}" DIRECTORY)
    file(MAKE_DIRECTORY "${PARENT}")
    file(COPY_FILE "${ROOT}/${RELATIVE}" "${WORK}/${RELATIVE}")
endforeach()
file(READ "${HELPER}/build-receipt.json" HELPER_RECEIPT)
string(JSON DEPENDENCY_COUNT LENGTH "${HELPER_RECEIPT}" dependencies)
if(DEPENDENCY_COUNT LESS 1 OR DEPENDENCY_COUNT GREATER 64)
    message(FATAL_ERROR "Bounded helper dependency inventory required")
endif()
set(HELPER_FILES build-receipt.json toolchain-receipt.json voyemu-java-helper.jar)
math(EXPR DEPENDENCY_LAST "${DEPENDENCY_COUNT} - 1")
foreach(INDEX RANGE 0 ${DEPENDENCY_LAST})
    string(JSON RELATIVE GET "${HELPER_RECEIPT}" dependencies ${INDEX} file)
    list(APPEND HELPER_FILES "${RELATIVE}")
endforeach()
foreach(RELATIVE IN LISTS HELPER_FILES)
    set(TARGET "${WORK}/.local/toolchains/java-helper/${FINGERPRINT}/${RELATIVE}")
    get_filename_component(PARENT "${TARGET}" DIRECTORY)
    file(MAKE_DIRECTORY "${PARENT}")
    file(COPY_FILE "${HELPER}/${RELATIVE}" "${TARGET}")
endforeach()
# Copy exactly three fixture JAR inputs: production consumers require canonical nlink1.
foreach(RELATIVE IN ITEMS build-tools/36.1.0/lib/d8.jar build-tools/36.1.0/lib/apksigner.jar
                         platforms/android-34/android.jar)
    set(SOURCE "${ROOT}/.local/toolchains/java-sdk/${RELATIVE}")
    set(TARGET "${WORK}/.local/toolchains/java-sdk/${RELATIVE}")
    get_filename_component(PARENT "${TARGET}" DIRECTORY)
    file(MAKE_DIRECTORY "${PARENT}")
    file(COPY_FILE "${SOURCE}" "${TARGET}")
endforeach()
set(OLD_BIN "${WORK}/old-jdk/bin")
file(MAKE_DIRECTORY "${OLD_BIN}")
if(CMAKE_HOST_WIN32)
    set(SUFFIX .exe)
else()
    set(SUFFIX "")
endif()
# The test executable implements only the Java17 discovery probe when copied as java.
file(COPY_FILE "${PROFILE_BUILD_TEST}" "${OLD_BIN}/java${SUFFIX}")
file(CHMOD "${OLD_BIN}/java${SUFFIX}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
    GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=JAVA_HOME "PATH=${OLD_BIN}"
    "${PROFILE_BUILD_TEST}" --observer-explicit-jdk "${WORK}" "${PROFILE}" "${JDK}"
    TIMEOUT 240 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "Explicit JDK observer dispatch failed: ${RESULT}\n${OUTPUT}${ERROR}\nFixture: ${WORK}")
endif()
message(STATUS "Explicit JDK bypassed Java17 PATH; observer compilation, host tests, D8 and cache verified: ${OUTPUT}")
file(REMOVE_RECURSE "${WORK}")
