get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/tmp/original-navi-identity-${TOKEN}")
file(MAKE_DIRECTORY "${WORK}/classes" "${WORK}/fixture")
file(GLOB_RECURSE TEST_SOURCES "${CMAKE_CURRENT_LIST_DIR}/android/*.java" "${CMAKE_CURRENT_LIST_DIR}/dalvik/*.java" "${CMAKE_CURRENT_LIST_DIR}/com/*.java")
set(PROVIDER "${ROOT}/profiles/common/components/canbus/src/com/qinggan/canbus/service")
set(HELPER "${ROOT}/profiles/free-11-chinese-20260731-7.3.1/patches/api30-original-navi-identity")
execute_process(COMMAND "${JAVAC}" --release 25 -d "${WORK}/classes" ${TEST_SOURCES} "${PROVIDER}/VinIdentityProvider.java" "${PROVIDER}/VinIdentityPolicy.java" "${HELPER}/vin-src/com/voyemu/qgapi/BrokerVin.java" "${HELPER}/vehicle-src/com/voyemu/qgapi/VehicleBroker.java" RESULT_VARIABLE RESULT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "identity compile: ${ERROR}")
endif()
execute_process(COMMAND "${JAVAC}" --release 25 -cp "${WORK}/classes" -d "${WORK}/fixture" "${CMAKE_CURRENT_LIST_DIR}/vehicle-src/com/qinggan/vehicle/VehicleConfigHelper.java" RESULT_VARIABLE RESULT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "fixture compile: ${ERROR}")
endif()
execute_process(COMMAND "${JAR}" cf "${WORK}/fixture.jar" -C "${WORK}/fixture" . RESULT_VARIABLE RESULT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "fixture jar: ${ERROR}")
endif()
# A synthetic self-signed signer stands in for the Navi certificate; the provider takes its SHA-256.
find_program(KEYTOOL keytool PATHS "$ENV{JAVA_HOME}/bin" NO_DEFAULT_PATH REQUIRED)
set(SIGNER "${WORK}/signer.der")
execute_process(COMMAND "${KEYTOOL}" -genkeypair -alias signer -keyalg EC -groupname secp256r1 -dname "CN=Voyemu synthetic Navi signer" -validity 1 -storetype PKCS12 -keystore "${WORK}/signer.p12" -storepass voyemu-test RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "synthetic signer: ${OUTPUT}${ERROR}")
endif()
execute_process(COMMAND "${KEYTOOL}" -exportcert -alias signer -storetype PKCS12 -keystore "${WORK}/signer.p12" -storepass voyemu-test -file "${SIGNER}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "synthetic signer export: ${OUTPUT}${ERROR}")
endif()
foreach(TEST IN ITEMS com.qinggan.canbus.service.VinIdentityProviderTest com.voyemu.qgapi.BrokerVinTest com.voyemu.qgapi.VehicleBrokerTest com.voyemu.qgapi.EarlyContextTest)
 execute_process(COMMAND "${JAVA}" -cp "${WORK}/classes" "${TEST}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
 if(NOT RESULT EQUAL 0)
  message(FATAL_ERROR "${TEST}: ${OUTPUT}${ERROR}")
 endif()
 message(STATUS "${OUTPUT}")
endforeach()
execute_process(COMMAND "${JAVA}" -cp "${WORK}/classes" com.qinggan.canbus.service.OemProviderTest "${SIGNER}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "OEM provider: ${OUTPUT}${ERROR}")
endif()
message(STATUS "${OUTPUT}")
execute_process(COMMAND "${JAVA}" -cp "${WORK}/classes" com.qinggan.canbus.service.VehicleProviderTest "${WORK}/fixture.jar" "${SIGNER}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "vehicle provider: ${OUTPUT}${ERROR}")
endif()
message(STATUS "${OUTPUT}")
file(REMOVE_RECURSE "${WORK}")
