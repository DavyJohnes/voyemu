get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/tmp/vin-provider-${TOKEN}")
file(MAKE_DIRECTORY "${WORK}")
set(IDENTITY_FIXTURE "${CMAKE_CURRENT_LIST_DIR}/../original-navi-identity")
file(GLOB_RECURSE TEST_SOURCES "${IDENTITY_FIXTURE}/android/*.java" "${IDENTITY_FIXTURE}/dalvik/*.java")
list(APPEND TEST_SOURCES "${IDENTITY_FIXTURE}/com/qinggan/os/SystemProperties.java" "${CMAKE_CURRENT_LIST_DIR}/com/qinggan/canbus/service/VinIdentityProviderTest.java")
set(SOURCE "${ROOT}/profiles/common/components/canbus/src/com/qinggan/canbus/service")
execute_process(COMMAND "${JAVAC}" -J-Xmx128m --release 25 -d "${WORK}" ${TEST_SOURCES} "${SOURCE}/VinIdentityPolicy.java" "${SOURCE}/VinIdentityProvider.java" TIMEOUT 30 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "VIN provider test compile: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
execute_process(COMMAND "${JAVA}" -Xmx128m -cp "${WORK}" com.qinggan.canbus.service.VinIdentityProviderTest TIMEOUT 15 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
file(REMOVE_RECURSE "${WORK}")
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "VIN provider test: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
message(STATUS "${OUTPUT}")
