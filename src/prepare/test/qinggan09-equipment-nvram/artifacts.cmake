cmake_minimum_required(VERSION 3.29)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
include("${ROOT}/src/prepare/test/java_source_dependencies.cmake")
file(GLOB_RECURSE SOURCES "${ROOT}/src/prepare/java/*.java")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/jobs/qinggan09-equipment-artifacts-test-${TOKEN}")
file(MAKE_DIRECTORY "${WORK}/classes")
execute_process(COMMAND "${JAVAC}" -J-Xmx512m --release 25 -proc:none -classpath "${JAVA_SOURCE_CLASSPATH}" -d "${WORK}/classes" ${SOURCES} "${ROOT}/src/prepare/test/java/com/voyemu/prepare/Qinggan09EquipmentArtifactsTest.java" TIMEOUT 90 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "A9 equipment artifact compile: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
execute_process(COMMAND "${JAVA}" -Xmx128m -cp "${WORK}/classes${CP_SEPARATOR}${JAVA_SOURCE_CLASSPATH}" com.voyemu.prepare.Qinggan09EquipmentArtifactsTest "${ROOT}" "${WORK}/work" TIMEOUT 30 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
file(REMOVE_RECURSE "${WORK}")
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "A9 equipment artifact test: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
message(STATUS "${OUTPUT}")
