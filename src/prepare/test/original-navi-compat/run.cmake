get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
include("${ROOT}/src/prepare/test/jdk.cmake")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef TOKEN)
set(WORK "${ROOT}/.local/build/tmp/original-navi-compat-${TOKEN}")
file(MAKE_DIRECTORY "${WORK}")
file(GLOB_RECURSE TEST_SOURCES "${ROOT}/src/prepare/test/fixtures/original-navi/*.java")
set(EGL "${ROOT}/profiles/free-11-chinese-20260731-7.3.1/patches/original-navi-egl/src/com/voyemu/egl")
set(LIB "${ROOT}/profiles/free-11-chinese-20260731-7.3.1/patches/original-navi-libraries/src/com/android/server/pm/parsing/library")
execute_process(COMMAND "${JAVAC}" -J-Xmx128m --release 25 -d "${WORK}" ${TEST_SOURCES} "${EGL}/ScopedEgl.java" "${EGL}/ScopedEglHook.java" "${LIB}/QgLibraries.java" "${ROOT}/profiles/free-11-chinese-20260731-7.3.1/patches/original-navi-egl/src/com/voyemu/navi/OwnContext.java" TIMEOUT 30 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
 message(FATAL_ERROR "Original Navi helper compile: ${RESULT}\n${OUTPUT}\n${ERROR}")
endif()
foreach(TEST ScopedEglTest ScopedEglHookTest com.voyemu.compat.QgLibrariesTest)
 execute_process(COMMAND "${JAVA}" -Xmx128m -cp "${WORK}" "${TEST}" TIMEOUT 15 RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
 if(NOT RESULT EQUAL 0)
  message(FATAL_ERROR "Original Navi helper test ${TEST}: ${RESULT}\n${OUTPUT}\n${ERROR}")
 endif()
 message(STATUS "${OUTPUT}")
endforeach()
file(REMOVE_RECURSE "${WORK}")
