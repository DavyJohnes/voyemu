cmake_minimum_required(VERSION 3.29)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef token)
set(WORK "${ROOT}/.local/build/jobs/prepare-java-phone-behavior-${token}")
if(CMAKE_HOST_WIN32)
 set(CP_SEPARATOR ";")
else()
 set(CP_SEPARATOR ":")
endif()
if(EXISTS "${WORK}" OR IS_SYMLINK "${WORK}")
 message(FATAL_ERROR "WORK must be fresh")
endif()
include("${ROOT}/src/prepare/test/jdk.cmake")
set(PLATFORM "${ROOT}/.local/toolchains/java-sdk/platforms/android-34/android.jar")
set(F "${ROOT}/src/prepare/test/fixtures")
set(BLUETOOTH "${ROOT}/profiles/common/components/bluetooth/src")
set(F611 "${ROOT}/profiles/free-11-chinese-20250710-6.11.1/components/bluetooth-611/src")
set(TESTS "${ROOT}/src/prepare/test/java/com/voyemu/prepare")
foreach(required "${PLATFORM}" "${F611}/Ivt8BTAdapter.java" "${F611}/PeerSubscription.java" "${F}/phone-pbap-race/fixture/PhonePbapRaceProbe.java")
 if(NOT EXISTS "${required}")
  message(FATAL_ERROR "Required input absent: ${required}")
 endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
 foreach(input IN ITEMS "${JAVA}" "${JAVAC}" "${PLATFORM}")
  file(SHA256 "${input}" sha)
  file(APPEND "${WORK}/provenance.sha256" "${sha}  ${input}\n")
 endforeach()
function(compile name cp)
 foreach(input IN LISTS ARGN)
  file(SHA256 "${input}" sha)
  file(APPEND "${WORK}/provenance.sha256" "${sha}  ${input}\n")
 endforeach()
 file(MAKE_DIRECTORY "${WORK}/${name}")
 execute_process(COMMAND "${JAVAC}" -J-Xmx512m -J-XX:ActiveProcessorCount=1 --release 25 -proc:none -encoding UTF-8 -cp "${cp}" -d "${WORK}/${name}" ${ARGN} WORKING_DIRECTORY "${ROOT}" TIMEOUT 60 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
 file(WRITE "${WORK}/${name}-compile.log" "${out}${err}")
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "${name} compile failed ${result}: ${out}${err}")
 endif()
endfunction()
file(GLOB_RECURSE boundary "${F}/phone-peer-process/android/*.java" "${F}/phone-peer-process/com/*.java" "${F}/phone-peer-process/org/*.java")
compile(boundary "${PLATFORM}" ${boundary} "${ROOT}/src/prepare/java/com/voyemu/prepare/Json.java")
file(GLOB_RECURSE sdk "${BLUETOOTH}/stub-cls/*.java")
list(FILTER sdk EXCLUDE REGEX "/(BTAdapter|A2dp|BluetoothCall|BTDevice|SimpleHfpCallback|SimplePbapCallback|BTDeviceManager|BTContactItem|BTPhoneNumber)\\.java$")
file(GLOB_RECURSE oem "${F}/phone-peer-process/fixture/oem/*.java")
compile(sdk "${WORK}/boundary${CP_SEPARATOR}${PLATFORM}" ${sdk} ${oem})
compile(f611 "${WORK}/boundary${CP_SEPARATOR}${WORK}/sdk${CP_SEPARATOR}${PLATFORM}" "${F611}/Ivt8BTAdapter.java" "${F611}/PeerSubscription.java" "${BLUETOOTH}/SyntheticPhonePeer.java" "${BLUETOOTH}/PeerConfiguration.java" "${F}/phone-peer-process/fixture/PhonePeerProcessProbe.java")
file(GLOB_RECURSE overlay "${F}/phone-settings/*.java")
compile(overlay "${WORK}/boundary${CP_SEPARATOR}${WORK}/sdk${CP_SEPARATOR}${PLATFORM}" ${overlay})
compile(harness "${PLATFORM}" "${TESTS}/SettingsPhoneAdapterTest.java" "${TESTS}/SettingsPhoneCapabilityTest.java" "${TESTS}/SyntheticPhonePeerPbapRaceTest.java")
set(FAILED)
function(run name class)
 file(MAKE_DIRECTORY "${WORK}/${name}/files" "${WORK}/${name}/tmp")
 execute_process(COMMAND "${JAVA}" -Xmx256m -XX:ActiveProcessorCount=1 "-Dphone.peer.test.files=${WORK}/${name}/files" "-Djava.io.tmpdir=${WORK}/${name}/tmp" -cp "${WORK}/harness" "com.voyemu.prepare.${class}" ${ARGN} WORKING_DIRECTORY "${ROOT}" TIMEOUT 30 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
 file(WRITE "${WORK}/${name}.log" "${out}${err}")
 if(NOT result EQUAL 0)
  set(FAILED ${FAILED} "${name}:${result}" PARENT_SCOPE)
  message(STATUS "FAIL ${name}: ${out}${err}")
 else()
  message(STATUS "PASS ${name}: ${out}")
 endif()
endfunction()
run(settings-adapter SettingsPhoneAdapterTest "${WORK}/f611" "${WORK}/boundary" "${WORK}/overlay" "${WORK}/sdk")
foreach(case normal death idle-restart corrupt-pending corrupt-empty corrupt-short corrupt-extra corrupt-oversize corrupt-directory)
 set(args)
 if(NOT case STREQUAL "normal")
  set(args "${case}")
 endif()
 run("capability-${case}" SettingsPhoneCapabilityTest "${WORK}/f611" "${WORK}/boundary" "${WORK}/overlay" "${WORK}/sdk" ${args})
endforeach()
file(GLOB_RECURSE pbap_overlay "${F}/phone-pbap-race/android/*.java")
# Overlay order is a runtime boundary requirement; compile-only base never replaces it.
compile(pbap-overlay "${WORK}/boundary${CP_SEPARATOR}${WORK}/sdk${CP_SEPARATOR}${PLATFORM}" ${pbap_overlay})
file(GLOB_RECURSE prod "${BLUETOOTH}/*.java")
list(FILTER prod EXCLUDE REGEX "/stub-cls/com/qinggan/bluetooth/(profile/(BTAdapter|BluetoothCall|A2dp|BTDevice|SimpleHfpCallback|SimplePbapCallback)|BTDeviceManager|bean/(BTContactItem|BTPhoneNumber))\\.java$")
compile(pbap-production "${WORK}/pbap-overlay${CP_SEPARATOR}${WORK}/boundary${CP_SEPARATOR}${PLATFORM}" ${prod} ${oem} "${F}/phone-pbap-race/fixture/PhonePbapRaceProbe.java")
compile(pbap-app "${WORK}/boundary${CP_SEPARATOR}${PLATFORM}" "${F}/phone-pbap-race/com/qinggan/bluetoothphone/logic/manager/CacheCallDataManager.java")
# Boundary URL in this entrypoint accepts one directory, so compile overridden boundary separately.
set(pbap_boundary ${boundary})
list(FILTER pbap_boundary EXCLUDE REGEX "/android/(os/(Handler|SystemClock)|content/Context)\\.java$")
compile(pbap-boundary "${PLATFORM}" ${pbap_boundary} ${pbap_overlay} "${ROOT}/src/prepare/java/com/voyemu/prepare/Json.java")
foreach(case history direct cancel reconnect timeout)
 run("pbap-${case}" SyntheticPhonePeerPbapRaceTest "${WORK}/pbap-production" "${WORK}/pbap-boundary" "${WORK}/pbap-app" "${PLATFORM}" "${case}")
endforeach()
if(FAILED)
 message(FATAL_ERROR "Failures: ${FAILED}")
endif()
# Keep compact evidence, then remove only the fresh random directory owned by this invocation.
set(SUMMARY "${WORK}-summary")
if(NOT WORK STREQUAL "${ROOT}/.local/build/jobs/prepare-java-phone-behavior-${token}"
        OR IS_SYMLINK "${WORK}" OR EXISTS "${SUMMARY}" OR IS_SYMLINK "${SUMMARY}")
    message(FATAL_ERROR "Owned success cleanup guard failed: ${WORK}")
endif()
file(MAKE_DIRECTORY "${SUMMARY}")
file(GLOB logs "${WORK}/*.log")
file(COPY ${logs} DESTINATION "${SUMMARY}")
file(GLOB_RECURSE artifacts "${WORK}/*.class")
foreach(artifact IN LISTS artifacts)
    file(SHA256 "${artifact}" sha)
    file(RELATIVE_PATH name "${WORK}" "${artifact}")
    file(APPEND "${SUMMARY}/artifacts.sha256" "${sha}  ${name}\n")
endforeach()
file(COPY "${WORK}/provenance.sha256" DESTINATION "${SUMMARY}")
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" runner_sha)
file(APPEND "${SUMMARY}/provenance.sha256" "${runner_sha}  ${CMAKE_CURRENT_LIST_FILE}\n")
file(WRITE "${SUMMARY}/summary.txt" "exit=0\nadapter_cases=1\ncapability_cases=9\npbap_cases=5\nwork=${WORK}\n")
file(REMOVE_RECURSE "${WORK}")
if(EXISTS "${WORK}" OR IS_SYMLINK "${WORK}")
    message(FATAL_ERROR "Owned WORK cleanup failed: ${WORK}")
endif()
message(STATUS "Phone behavior PASS; summary ${SUMMARY}")
