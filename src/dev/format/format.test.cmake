# Runs format.cmake on the fixtures of src/dev/format/test: check mode must reject each unformatted
# fixture X.<ext>, fix mode must turn it into X.formatted.<ext>, and check mode must then accept it.
# Usage: cmake [-DWORK=<directory>] [-DVOYEMU_CLANG_FORMAT=<path>] [-DVOYEMU_GOOGLE_JAVA_FORMAT=<path>]
#        [-DVOYEMU_UNCRUSTIFY=<path>] -P src/dev/format/format.test.cmake
cmake_minimum_required(VERSION 3.22)
get_filename_component(voyemu_root "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
if(NOT WORK)
    set(WORK "${voyemu_root}/.local/build/tmp/format-test")
endif()
set(format_script "${CMAKE_CURRENT_LIST_DIR}/format.cmake")
set(fixtures "${CMAKE_CURRENT_LIST_DIR}/test")
file(GLOB inputs RELATIVE "${fixtures}" "${fixtures}/*")
list(FILTER inputs EXCLUDE REGEX "\\.formatted\\.")
if(NOT inputs)
    message(FATAL_ERROR "No formatter fixtures in ${fixtures}")
endif()

# Runs format.cmake in mode on the fixture copies of WORK; sets result to its exit code.
function(voyemu_format_fixtures mode result)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DVOYEMU_FORMAT_MODE=${mode} "-DVOYEMU_FORMAT_DIRECTORY=${WORK}"
                            "-DVOYEMU_CLANG_FORMAT=${VOYEMU_CLANG_FORMAT}" "-DVOYEMU_GOOGLE_JAVA_FORMAT=${VOYEMU_GOOGLE_JAVA_FORMAT}" "-DVOYEMU_UNCRUSTIFY=${VOYEMU_UNCRUSTIFY}"
                            -P "${format_script}"
                    OUTPUT_VARIABLE output ERROR_VARIABLE output RESULT_VARIABLE code)
    set(${result} ${code} PARENT_SCOPE)
    set(voyemu_format_output "${output}" PARENT_SCOPE)
endfunction()

set(failures)
foreach(input IN LISTS inputs)
    file(REMOVE_RECURSE "${WORK}")
    file(MAKE_DIRECTORY "${WORK}")
    file(COPY "${fixtures}/${input}" DESTINATION "${WORK}")
    voyemu_format_fixtures(check code)
    if(code EQUAL 0)
        list(APPEND failures "${input}: check mode accepted the unformatted fixture")
    elseif(NOT voyemu_format_output MATCHES "${input}: blank lines differ")
        list(APPEND failures "${input}: check mode failed without reporting its blank lines:\n${voyemu_format_output}")
    endif()
    voyemu_format_fixtures(fix code)
    if(NOT code EQUAL 0)
        list(APPEND failures "${input}: fix mode failed:\n${voyemu_format_output}")
        continue()
    endif()
    string(REGEX REPLACE "\\.([^.]+)$" ".formatted.\\1" expected "${input}")
    file(READ "${fixtures}/${expected}" wanted)
    file(READ "${WORK}/${input}" actual)
    if(NOT actual STREQUAL wanted)
        list(APPEND failures "${input}: fix mode result differs from ${expected}:\n${actual}")
        continue()
    endif()
    voyemu_format_fixtures(check code)
    if(NOT code EQUAL 0)
        list(APPEND failures "${input}: check mode rejected the formatted fixture:\n${voyemu_format_output}")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
if(failures)
    string(JOIN "\n" text ${failures})
    message(FATAL_ERROR "${text}")
endif()
list(LENGTH inputs count)
message(STATUS "Formatter fixtures passed: ${count}")
