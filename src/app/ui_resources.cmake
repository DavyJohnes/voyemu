include("${CMAKE_CURRENT_LIST_DIR}/embedded_deflate.cmake")
set(voyemu_ui_resources "")
foreach(pair IN ITEMS "regular_font|${CLUSTER_FONT}" "medium_font|${CLUSTER_TAB_FONT}" "bold_font|${CLUSTER_BOLD_FONT}" "application_icon|${CMAKE_CURRENT_SOURCE_DIR}/../assets/voyemu-icon.png" "logo_text|${CMAKE_CURRENT_SOURCE_DIR}/../assets/voyemu-logo-text.svg" "logo_figure|${CMAKE_CURRENT_SOURCE_DIR}/../assets/voyemu-logo-figure.svg" "screens_icon|${CMAKE_CURRENT_SOURCE_DIR}/../assets/voyemu-screens-icon.svg" "chinese_font|${CLUSTER_CJK_FONT}" "chinese_medium_font|${CLUSTER_CJK_MEDIUM_FONT}" "chinese_bold_font|${CLUSTER_CJK_BOLD_FONT}")
    string(REPLACE "|" ";" entry "${pair}")
    list(GET entry 0 name)
    list(GET entry 1 path)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    voyemu_deflate_initializer("${path}" "${CMAKE_CURRENT_BINARY_DIR}/ui_resources.gz" values size)
    string(APPEND voyemu_ui_resources "static constexpr std::uint8_t ${name}[]={${values}};\nstatic constexpr std::size_t ${name}_size=${size};\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/ui_resources.inc" "${voyemu_ui_resources}")
