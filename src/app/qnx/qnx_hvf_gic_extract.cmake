# Exercise the actual owned bridge and STR handler from the pinned QEMU patch.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../qnx-host.patch" _hvf_patch)
if(NOT DEFINED VOYEMU_HVF_OUTPUT_DIR)
    set(VOYEMU_HVF_OUTPUT_DIR "${CMAKE_CURRENT_BINARY_DIR}/qnx-hvf-test")
endif()
file(MAKE_DIRECTORY "${VOYEMU_HVF_OUTPUT_DIR}")
set(_hvf_header_marker "+++ b/hw/intc/arm_gicv3_hvf_mmio.h\n")
string(FIND "${_hvf_patch}" "${_hvf_header_marker}" _hvf_start)
if(_hvf_start LESS 0)
    message(FATAL_ERROR "HVF bridge patch header missing")
endif()
string(LENGTH "${_hvf_header_marker}" _hvf_marker_length)
math(EXPR _hvf_start "${_hvf_start} + ${_hvf_marker_length}")
string(SUBSTRING "${_hvf_patch}" ${_hvf_start} -1 _hvf_header)
string(FIND "${_hvf_header}" "\n" _hvf_body)
math(EXPR _hvf_body "${_hvf_body} + 1")
string(FIND "${_hvf_header}" "\n+/* Public redistributor APIs" _hvf_end)
math(EXPR _hvf_length "${_hvf_end} - ${_hvf_body}")
if(_hvf_length LESS 1)
    message(FATAL_ERROR "HVF bridge transfer boundary missing")
endif()
string(SUBSTRING "${_hvf_header}" ${_hvf_body} ${_hvf_length} _hvf_header)
string(REGEX REPLACE "(^|\n)[+]" "\\1" _hvf_header "${_hvf_header}")
file(WRITE "${VOYEMU_HVF_OUTPUT_DIR}/qnx-hvf-gic-transfer.h" "${_hvf_header}\n#endif\n")
string(FIND "${_hvf_patch}" "+/* Integer STR with immediate pre/post-index writeback, no SIMD or loads. */" _hvf_start)
string(FIND "${_hvf_patch}" "\n static void clamp_id_aa64mmfr0_parange_to_ipa_size" _hvf_end)
math(EXPR _hvf_length "${_hvf_end} - ${_hvf_start}")
if(_hvf_start LESS 0 OR _hvf_length LESS 1)
    message(FATAL_ERROR "HVF STR writeback boundary missing")
endif()
string(SUBSTRING "${_hvf_patch}" ${_hvf_start} ${_hvf_length} _hvf_str)
string(REGEX REPLACE "(^|\n)[+ ]" "\\1" _hvf_str "${_hvf_str}")
file(WRITE "${VOYEMU_HVF_OUTPUT_DIR}/qnx-hvf-str-writeback.h" "${_hvf_str}\n")
