# Static SDL3 for the single host window; the source archive is pinned in platform/component.json.
include_guard(GLOBAL)
include(FetchContent)
include("${CMAKE_CURRENT_LIST_DIR}/window_linux.cmake")

function(voyemu_window_dependencies)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    set(component "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/platform/component.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${component}")
    file(READ "${component}" metadata)
    string(JSON schema GET "${metadata}" schema)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "Unsupported window component schema")
    endif()
    string(JSON url GET "${metadata}" window_sdl3 url)
    string(JSON sha GET "${metadata}" window_sdl3 sha256)
    string(LENGTH "${sha}" sha_length)
    if(NOT sha_length EQUAL 64 OR NOT sha MATCHES "^[0-9a-f]+$" OR NOT url MATCHES "^https://")
        message(FATAL_ERROR "Invalid pinned window source: SDL3")
    endif()
    get_filename_component(project_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." REALPATH)
    set(cached "${project_root}/.local/toolchains/downloads/sources/${sha}.tar.gz")
    if(EXISTS "${cached}")
        if(IS_SYMLINK "${cached}")
            message(FATAL_ERROR "Linked window archive: SDL3")
        endif()
        set(url "${cached}")
    endif()
    FetchContent_Declare(voyemu_window_sdl3 URL "${url}" URL_HASH "SHA256=${sha}" SOURCE_SUBDIR voyemu_source_only)
    FetchContent_MakeAvailable(voyemu_window_sdl3)

    # Upstream options are cache entries; scope them to this dependency and restore the caller's.
    macro(voyemu_window_option name value)
        if(NOT "${name}" IN_LIST window_options)
            list(APPEND window_options "${name}")
            get_property(saved_${name}_exists CACHE "${name}" PROPERTY TYPE SET)
            if(saved_${name}_exists)
                get_property(saved_${name}_type CACHE "${name}" PROPERTY TYPE)
                get_property(saved_${name}_help CACHE "${name}" PROPERTY HELPSTRING)
                set(saved_${name}_value "$CACHE{${name}}")
            endif()
        endif()
        set(${name} "${value}" CACHE STRING "Scoped window dependency option" FORCE)
        set(${name} "${value}")
    endmacro()
    voyemu_window_option(BUILD_TESTING OFF)
    voyemu_window_option(SDL_SHARED OFF)
    voyemu_window_option(SDL_STATIC ON)
    voyemu_window_option(SDL_TEST_LIBRARY OFF)
    voyemu_window_option(SDL_TESTS OFF)
    voyemu_window_option(SDL_EXAMPLES OFF)
    voyemu_window_option(SDL_INSTALL OFF)
    voyemu_window_option(SDL_DISABLE_INSTALL ON)
    # The window uses video, events and the 2D renderer only.
    foreach(subsystem AUDIO GPU CAMERA JOYSTICK HAPTIC HIDAPI POWER SENSOR DIALOG TRAY VULKAN RENDER_VULKAN RENDER_GPU)
        voyemu_window_option(SDL_${subsystem} OFF)
    endforeach()
    # Renderers: Direct3D 11 on Windows and Metal on macOS, OpenGL after them and the software renderer
    # last. The Direct3D 9 and 12 drivers come only after a failed Direct3D 11, and OpenGL ES needs an
    # EGL library that neither host ships; Linux keeps OpenGL ES, whose EGL the Wayland driver uses.
    if(WIN32)
        voyemu_window_option(SDL_RENDER_D3D OFF)
        voyemu_window_option(SDL_RENDER_D3D12 OFF)
    endif()
    if(WIN32 OR APPLE)
        voyemu_window_option(SDL_OPENGLES OFF)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        # X11 and Wayland from the pinned headers of window_linux.cmake; SDL loads the system
        # libraries by their sonames when the window opens.
        voyemu_window_linux()
        foreach(driver X11 WAYLAND X11_SHARED WAYLAND_SHARED WAYLAND_LIBDECOR WAYLAND_LIBDECOR_SHARED)
            voyemu_window_option(SDL_${driver} ON)
        endforeach()
        foreach(driver KMSDRM LIBUDEV DBUS IBUS X11_XTEST)
            voyemu_window_option(SDL_${driver} OFF)
        endforeach()
    endif()
    # SDL's few C++ sources use no modules; C++20 scanning would require clang-scan-deps.
    set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
    add_subdirectory("${voyemu_window_sdl3_SOURCE_DIR}" "${voyemu_window_sdl3_BINARY_DIR}" EXCLUDE_FROM_ALL)
    # The launcher links SDL statically and never replaces it at run time, so the dynamic API, whose
    # jump table keeps every SDL function linked, is compiled out. SDL_dynapi.h refuses a direct
    # SDL_DYNAMIC_API=0; SDL_THREAD_SAFETY_ANALYSIS turns it off and otherwise only adds Clang
    # thread-safety attributes, which no warning flag checks here.
    target_compile_definitions(SDL3-static PRIVATE SDL_THREAD_SAFETY_ANALYSIS)
    foreach(name IN LISTS window_options)
        if(saved_${name}_exists)
            set(${name} "${saved_${name}_value}" CACHE ${saved_${name}_type} "${saved_${name}_help}" FORCE)
        else()
            unset(${name} CACHE)
        endif()
    endforeach()
    get_target_property(sdl_kind SDL3-static TYPE)
    if(NOT sdl_kind STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "Pinned static SDL3 configuration required")
    endif()
endfunction()

voyemu_window_dependencies()
