# Runs an e2fsprogs helper shell test against the helper that preparation installed from its pin.
# Usage: cmake -DHELPER=a9-offline-labels|api30-root-layout -DWORK=<fresh directory> -P e2fs_helper.test.cmake
# Skips with 77 until preparation installed the helper and e2fsprogs mke2fs/debugfs/e2fsck are installed.
cmake_minimum_required(VERSION 3.29)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(HELPER STREQUAL "a9-offline-labels")
    set(script "${root}/src/app/prepare/a9_offline_labels_helper.test.sh")
elseif(HELPER STREQUAL "api30-root-layout")
    set(script "${root}/src/app/prepare/api30_root_layout_helper.test.sh")
else()
    message(FATAL_ERROR "Unknown e2fsprogs helper: ${HELPER}")
endif()
if(CMAKE_HOST_APPLE)
    set(host darwin-arm64)
else()
    set(host linux-x64)
endif()
file(READ "${root}/src/app/toolchain.json" pins)
string(JSON sha GET "${pins}" e2fsprogs helpers ${host} ${HELPER} sha256)
set(helper "${root}/.local/toolchains/e2fs-helpers/${sha}/${HELPER}")
if(EXISTS "${helper}")
    file(SHA256 "${helper}" actual)
    if(NOT actual STREQUAL sha)
        message(FATAL_ERROR "Installed ${HELPER} differs from its pin: ${helper}")
    endif()
else()
    set(helper "")
endif()
set(hints /opt/homebrew/opt/e2fsprogs/sbin /usr/local/opt/e2fsprogs/sbin /usr/sbin /sbin)
find_program(mke2fs mke2fs HINTS ${hints} NO_CACHE)
find_program(debugfs debugfs HINTS ${hints} NO_CACHE)
find_program(e2fsck e2fsck HINTS ${hints} NO_CACHE)
if(NOT helper OR NOT mke2fs OR NOT debugfs OR NOT e2fsck)
    message(STATUS "SKIP ${HELPER}: installed helper '${helper}', mke2fs '${mke2fs}', debugfs '${debugfs}', e2fsck '${e2fsck}'")
    cmake_language(EXIT 77)
endif()
file(REMOVE_RECURSE "${WORK}")
if(HELPER STREQUAL "a9-offline-labels")
    set(arguments "${helper}" "${mke2fs}" "${debugfs}" "${e2fsck}" "${WORK}")
else()
    set(arguments "${helper}" "${mke2fs}" "${debugfs}" "${WORK}")
endif()
execute_process(COMMAND /bin/bash "${script}" ${arguments} TIMEOUT 120 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "${HELPER} helper test failed: ${result}; diagnostics: ${WORK}")
endif()
file(REMOVE_RECURSE "${WORK}")
