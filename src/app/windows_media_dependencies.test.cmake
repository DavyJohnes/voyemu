# Include from a minimal, separate C/C++ project to exercise the bootstrap
# without configuring the application's SDK, graphics or guest targets.
set(BUILD_TESTING ON CACHE BOOL "Caller test preference" FORCE)
set(BUILD_SHARED_LIBS ON CACHE BOOL "Caller shared-library preference" FORCE)
set(CURL_BROTLI ON CACHE STRING "Caller compression preference" FORCE)
set(USE_LIBIDN2 ON CACHE BOOL "Caller IDN preference" FORCE)
include("${CMAKE_CURRENT_LIST_DIR}/windows_media_dependencies.cmake")
if(NOT BUILD_TESTING OR NOT BUILD_SHARED_LIBS OR NOT CURL_BROTLI OR NOT USE_LIBIDN2)
    message(FATAL_ERROR "Windows media dependency options leaked into caller")
endif()
if(NOT "$CACHE{BUILD_TESTING}" OR NOT "$CACHE{BUILD_SHARED_LIBS}" OR NOT "$CACHE{CURL_BROTLI}" OR NOT "$CACHE{USE_LIBIDN2}")
    message(FATAL_ERROR "Windows media dependency options changed caller cache")
endif()
if(TARGET libcurl_shared OR TARGET curl OR TARGET nghttp2_shared)
    message(FATAL_ERROR "Unexpected Windows media shared library or application")
endif()
add_executable(windows_http2_dependency_test "${CMAKE_CURRENT_LIST_DIR}/api/windows_http2_dependency.test.cpp")
target_compile_features(windows_http2_dependency_test PRIVATE cxx_std_20)
target_compile_options(windows_http2_dependency_test PRIVATE -UNDEBUG)
target_link_libraries(windows_http2_dependency_test PRIVATE CURL::libcurl_static nghttp2::nghttp2_static ws2_32)
