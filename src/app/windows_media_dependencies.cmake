# Build-time HTTP/2 libraries for the frame server and the SDK media client; macOS uses system libcurl.
include_guard(GLOBAL)
include(FetchContent)

function(voyemu_media_dependencies)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    set(component "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/api/component.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${component}")
    file(READ "${component}" metadata)
    string(JSON schema GET "${metadata}" schema)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "Unsupported media component schema")
    endif()
    get_filename_component(project_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." REALPATH)
    set(components nghttp2)
    if(NOT APPLE)
        list(APPEND components curl)
    endif()
    foreach(name IN LISTS components)
        string(JSON url GET "${metadata}" windows_media_http2 ${name} url)
        string(JSON sha GET "${metadata}" windows_media_http2 ${name} sha256)
        string(LENGTH "${sha}" sha_length)
        if(NOT sha_length EQUAL 64 OR NOT sha MATCHES "^[0-9a-f]+$" OR NOT url MATCHES "^https://")
            message(FATAL_ERROR "Invalid pinned media source: ${name}")
        endif()
        set(cached "${project_root}/.local/toolchains/downloads/sources/${sha}.tar.xz")
        if(EXISTS "${cached}")
            if(IS_SYMLINK "${cached}")
                message(FATAL_ERROR "Linked media archive: ${name}")
            endif()
            file(SHA256 "${cached}" actual)
            if(NOT actual STREQUAL sha)
                message(FATAL_ERROR "Media archive SHA mismatch: ${name}")
            endif()
            set(url "${cached}")
        endif()
        # Populate first; add the upstream projects below after scoping options.
        FetchContent_Declare(voyemu_media_${name} URL "${url}" URL_HASH "SHA256=${sha}" SOURCE_SUBDIR voyemu_source_only)
        FetchContent_MakeAvailable(voyemu_media_${name})
    endforeach()

    # Some upstream helpers FORCE cache options (including BUILD_TESTING),
    # so save/restore each overridden entry as well as using function scope.
    macro(voyemu_media_option name value)
        if(NOT "${name}" IN_LIST media_options)
            list(APPEND media_options "${name}")
            get_property(saved_${name}_exists CACHE "${name}" PROPERTY TYPE SET)
            if(saved_${name}_exists)
                get_property(saved_${name}_type CACHE "${name}" PROPERTY TYPE)
                get_property(saved_${name}_help CACHE "${name}" PROPERTY HELPSTRING)
                set(saved_${name}_value "$CACHE{${name}}")
            endif()
        endif()
        set(${name} "${value}" CACHE STRING "Scoped media dependency option" FORCE)
        set(${name} "${value}")
    endmacro()
    foreach(package Python3 Perl OpenSSL Libngtcp2 Libnghttp3 Systemd Jansson Libevent LibXml2 Jemalloc)
        set(CMAKE_DISABLE_FIND_PACKAGE_${package} TRUE)
    endforeach()
    # Normal variables are confined to this function and honored by upstream
    # CMP0077 options. In particular, the application's tests remain enabled.
    voyemu_media_option(BUILD_TESTING OFF)
    voyemu_media_option(BUILD_SHARED_LIBS OFF)
    voyemu_media_option(BUILD_STATIC_LIBS ON)
    voyemu_media_option(BUILD_EXAMPLES OFF)
    voyemu_media_option(ENABLE_LIB_ONLY ON)
    voyemu_media_option(ENABLE_APP OFF)
    voyemu_media_option(ENABLE_DOC OFF)
    voyemu_media_option(ENABLE_EXAMPLES OFF)
    voyemu_media_option(ENABLE_HPACK_TOOLS OFF)
    voyemu_media_option(ENABLE_FAILMALLOC OFF)
    add_subdirectory("${voyemu_media_nghttp2_SOURCE_DIR}" "${voyemu_media_nghttp2_BINARY_DIR}" EXCLUDE_FROM_ALL)
    add_library(nghttp2::nghttp2_static ALIAS nghttp2_static)

    if(NOT APPLE)
        voyemu_media_option(BUILD_CURL_EXE OFF)
        voyemu_media_option(BUILD_STATIC_CURL OFF)
        voyemu_media_option(BUILD_LIBCURL_DOCS OFF)
        voyemu_media_option(BUILD_MISC_DOCS OFF)
        voyemu_media_option(ENABLE_CURL_MANUAL OFF)
        voyemu_media_option(CURL_DISABLE_INSTALL ON)
        voyemu_media_option(CURL_ENABLE_EXPORT_TARGET OFF)
        voyemu_media_option(CURL_ENABLE_SSL OFF)
        voyemu_media_option(CURL_ENABLE_NTLM OFF)
        voyemu_media_option(CURL_USE_PKGCONFIG OFF)
        voyemu_media_option(CURL_USE_CMAKECONFIG OFF)
        voyemu_media_option(CURL_ZLIB OFF)
        voyemu_media_option(CURL_BROTLI OFF)
        voyemu_media_option(CURL_ZSTD OFF)
        foreach(feature LIBPSL LIBSSH LIBSSH2 GSSAPI GSASL LIBUV LIBBACKTRACE)
            voyemu_media_option(CURL_USE_${feature} OFF)
        endforeach()
        foreach(feature LIBIDN2 WIN32_IDN NGTCP2 QUICHE PROXY_HTTP3 ECH HTTPSRR)
            voyemu_media_option(USE_${feature} OFF)
        endforeach()
        foreach(feature ARES THREADED_RESOLVER UNIX_SOCKETS)
            voyemu_media_option(ENABLE_${feature} OFF)
        endforeach()
        foreach(protocol DICT FILE FTP GOPHER IMAP IPFS LDAP LDAPS MQTT POP3 RTSP SMTP TELNET TFTP WEBSOCKETS)
            voyemu_media_option(CURL_DISABLE_${protocol} ON)
        endforeach()
        voyemu_media_option(CURL_DISABLE_HTTP OFF)
        voyemu_media_option(USE_NGHTTP2 ON)
        voyemu_media_option(NGHTTP2_USE_STATIC_LIBS ON)
        set(NGHTTP2_INCLUDE_DIR "${voyemu_media_nghttp2_SOURCE_DIR}/lib/includes")
        # A CMake target, not an ABI-specific archive filename. Upstream curl's
        # FindNGHTTP2 propagates this through its CURL::nghttp2 interface target.
        set(NGHTTP2_LIBRARY nghttp2_static)
        add_subdirectory("${voyemu_media_curl_SOURCE_DIR}" "${voyemu_media_curl_BINARY_DIR}" EXCLUDE_FROM_ALL)
    endif()
    foreach(name IN LISTS media_options)
        if(saved_${name}_exists)
            set(${name} "${saved_${name}_value}" CACHE ${saved_${name}_type} "${saved_${name}_help}" FORCE)
        else()
            unset(${name} CACHE)
        endif()
    endforeach()
    get_target_property(nghttp2_kind nghttp2_static TYPE)
    if(NOT nghttp2_kind STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "Pinned static nghttp2 configuration required")
    endif()
    if(NOT APPLE)
        get_target_property(curl_kind libcurl_static TYPE)
        file(READ "${voyemu_media_curl_BINARY_DIR}/lib/curl_config.h" config)
        if(NOT curl_kind STREQUAL "STATIC_LIBRARY" OR NOT config MATCHES "#define USE_NGHTTP2 1")
            message(FATAL_ERROR "Pinned static media HTTP/2 configuration required")
        endif()
    endif()
endfunction()

voyemu_media_dependencies()
