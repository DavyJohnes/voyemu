set(qnx_host_source "${CMAKE_CURRENT_SOURCE_DIR}/qnx-host.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${qnx_host_source}")
file(READ "${qnx_host_source}" qnx_host_json)
string(JSON qnx_host_schema GET "${qnx_host_json}" schema)
if(NOT qnx_host_schema EQUAL 1)
    message(FATAL_ERROR "Unsupported QNX host component schema")
endif()
string(HEX "${qnx_host_json}" qnx_host_hex)
string(REGEX REPLACE "(..)" "0x\\1," qnx_host_bytes "${qnx_host_hex}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/qnx_host_catalog.inc" "static constexpr unsigned char qnx_host_json[]={${qnx_host_bytes}};\n")
