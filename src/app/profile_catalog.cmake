# Embed only public profile definitions, never their private OEM inputs.
file(GLOB voyemu_profile_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/../../profiles/*/profile.json")
list(SORT voyemu_profile_files)
set(voyemu_catalog "[")
set(voyemu_separator "")
foreach(source IN LISTS voyemu_profile_files)
    get_filename_component(directory "${source}" DIRECTORY)
    get_filename_component(id "${directory}" NAME)
    if(NOT id MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$")
        message(FATAL_ERROR "Invalid embedded profile id")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" definition)
    string(JSON schema GET "${definition}" schema)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "Unsupported embedded profile schema")
    endif()
    string(JSON local ERROR_VARIABLE local_missing GET "${definition}" local)
    if(NOT local_missing AND local)
        continue()
    endif()
    string(JSON status ERROR_VARIABLE status_missing GET "${definition}" status)
    if(NOT status_missing AND NOT status STREQUAL "ready")
        continue()
    endif()
    file(SHA256 "${source}" digest)
    string(APPEND voyemu_catalog "${voyemu_separator}{\"id\":\"${id}\",\"sha256\":\"${digest}\",\"definition\":${definition}}")
    set(voyemu_separator ",")
endforeach()
if(NOT voyemu_profile_files)
    message(FATAL_ERROR "At least one source profile required")
endif()
string(APPEND voyemu_catalog "]")
# Byte initializers avoid compiler string-literal limits and preserve UTF-8 verbatim.
string(HEX "${voyemu_catalog}" voyemu_catalog_hex)
string(REGEX REPLACE "(..)" "0x\\1," voyemu_catalog_bytes "${voyemu_catalog_hex}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/profile_catalog.inc" "static constexpr unsigned char embedded_catalog_json[]={${voyemu_catalog_bytes}};\n")
