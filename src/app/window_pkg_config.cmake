# The pkg-config that the SDL3 configuration runs on Linux for its Wayland modules, as
# cmake -DVOYEMU_PKG_CONFIG=<modules.json> -P window_pkg_config.cmake -- <pkg-config arguments>.
# It answers the queries of FindPkgConfig from the pinned window headers that window_linux.cmake
# writes; every module has the shared include directory and links nothing but its soname stub.
cmake_minimum_required(VERSION 3.22)
file(READ "${VOYEMU_PKG_CONFIG}" metadata)
string(JSON include GET "${metadata}" include)
string(JSON libdir GET "${metadata}" lib)
set(query "")
set(modules "")
set(arguments FALSE)
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(index RANGE ${last})
    set(argument "${CMAKE_ARGV${index}}")
    if(arguments)
        if(argument MATCHES "^--")
            if(NOT argument MATCHES "^--(print-errors|short-errors|static)$")
                set(query "${argument}")
            endif()
        else()
            string(REGEX REPLACE " .*" "" name "${argument}")
            list(APPEND modules "${name}")
        endif()
    elseif(argument STREQUAL "--")
        set(arguments TRUE)
    endif()
endforeach()
if(query STREQUAL "--version")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "0.29.2")
    return()
endif()
set(output "")
foreach(name IN LISTS modules)
    string(JSON entry ERROR_VARIABLE missing GET "${metadata}" modules "${name}")
    if(missing)
        message("Package ${name} was not found")
        cmake_language(EXIT 1)
    endif()
    string(JSON version GET "${entry}" 0)
    string(JSON library GET "${entry}" 1)
    if(query STREQUAL "--modversion")
        list(APPEND output "${version}")
    elseif(query MATCHES "^--variable=(.*)$")
        set(variables prefix "${include}/.." includedir "${include}" libdir "${libdir}")
        list(FIND variables "${CMAKE_MATCH_1}" at)
        if(at GREATER_EQUAL 0)
            math(EXPR at "${at} + 1")
            list(GET variables ${at} value)
            list(APPEND output "${value}")
        endif()
    elseif(query MATCHES "^--(cflags|cflags-only-I)$")
        list(APPEND output "-I${include}")
    elseif(query MATCHES "^--(libs|libs-only-L|libs-only-l)$" AND library)
        if(NOT query STREQUAL "--libs-only-l")
            list(APPEND output "-L${libdir}")
        endif()
        if(NOT query STREQUAL "--libs-only-L")
            list(APPEND output "-l${library}")
        endif()
    endif()
endforeach()
list(REMOVE_DUPLICATES output)
list(JOIN output " " output)
execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${output}")
