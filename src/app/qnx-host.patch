+/* Integer STP W offset form; other forms remain explicitly unsupported. */
+static bool hvf_decode_stp_w_offset(uint32_t insn, unsigned *rn,
+                                  unsigned *rt, unsigned *rt2, int32_t *offset)
+{
+    int32_t immediate;
+
+    if ((insn & 0xffc00000U) != 0x29000000U) {
+        return false;
+    }
+    *rn = (insn >> 5) & 31;
+    *rt = insn & 31;
+    *rt2 = (insn >> 10) & 31;
+    immediate = (insn >> 15) & 127;
+    if (immediate & 64) {
+        immediate -= 128;
+    }
+    *offset = immediate * 4;
+    return true;
+}
+
+/* ISV is clear for pair accesses. Perform both stores, never discard them. */
+static bool hvf_handle_stp_w_mmio(CPUState *cpu, AddressSpace *as,
+                                uint64_t va, uint64_t ipa)
+{
+    ARMCPU *arm_cpu = ARM_CPU(cpu);
+    uint64_t pc, base;
+    unsigned rn, rt, rt2;
+    int32_t offset;
+    uint8_t code[4], first[4], second[4];
+    MemTxResult result;
+
+    cpu_synchronize_state(cpu);
+    if (!is_a64(&arm_cpu->env) || arm_cpu_data_is_big_endian(&arm_cpu->env) ||
+        hv_vcpu_get_reg(cpu->accel->fd, HV_REG_PC, &pc) != HV_SUCCESS ||
+        cpu_memory_rw_debug(cpu, pc, code, sizeof(code), false) != 0 ||
+        !hvf_decode_stp_w_offset(ldl_le_p(code), &rn, &rt, &rt2, &offset)) {
+        return false;
+    }
+    /* SP addressing and page-crossing translations need their own decoder. */
+    if (rn == 31 || (ipa & 3) || (ipa & 4095) > 4088) {
+        return false;
+    }
+    base = hvf_get_reg(cpu, rn);
+    if (base + (int64_t)offset != va) {
+        return false;
+    }
+    stl_le_p(first, hvf_get_reg(cpu, rt));
+    stl_le_p(second, hvf_get_reg(cpu, rt2));
+    result = address_space_write(as, ipa, MEMTXATTRS_UNSPECIFIED, first, 4);
+    if (result != MEMTX_OK) {
+        return false;
+    }
+    result = address_space_write(as, ipa + 4, MEMTXATTRS_UNSPECIFIED, second, 4);
+    if (result != MEMTX_OK) {
+        return false;
+    }
+    error_report("HVF STP W MMIO completed: cpu=%d pc=0x%" PRIx64
+                 " ipa=0x%" PRIx64, cpu->cpu_index, pc, ipa);
+    return true;
+}
+
+/* Integer STR with immediate pre/post-index writeback, no SIMD or loads. */
+static bool hvf_decode_str_writeback(uint32_t insn, unsigned *rn,
+                                    unsigned *rt, int32_t *offset,
+                                    unsigned *length, bool *preindex)
+{
+    int32_t immediate;
+
+    if ((insn & 0x3fe00400U) != 0x38000400U) {
+        return false;
+    }
+    *rn = (insn >> 5) & 31;
+    *rt = insn & 31;
+    *length = 1U << (insn >> 30);
+    *preindex = (insn >> 11) & 1;
+    immediate = (insn >> 12) & 511;
+    if (immediate & 256) {
+        immediate -= 512;
+    }
+    *offset = immediate;
+    return true;
+}
+
+static bool hvf_handle_str_writeback_mmio(CPUState *cpu, AddressSpace *as,
+                                        uint64_t va, uint64_t ipa)
+{
+    ARMCPU *arm_cpu = ARM_CPU(cpu);
+    uint64_t pc, base, value;
+    unsigned rn, rt, length;
+    int32_t offset;
+    bool preindex;
+    uint8_t code[4], bytes[8];
+
+    cpu_synchronize_state(cpu);
+    if (!is_a64(&arm_cpu->env) || arm_cpu_data_is_big_endian(&arm_cpu->env) ||
+        hv_vcpu_get_reg(cpu->accel->fd, HV_REG_PC, &pc) != HV_SUCCESS ||
+        cpu_memory_rw_debug(cpu, pc, code, sizeof(code), false) != 0 ||
+        !hvf_decode_str_writeback(ldl_le_p(code), &rn, &rt, &offset,
+                                  &length, &preindex)) {
+        return false;
+    }
+    /* Reject SP, constrained-unpredictable overlap and page crossings. */
+    if (rn == 31 || rn == rt || (ipa & (length - 1)) ||
+        (ipa & 4095) > 4096 - length) {
+        return false;
+    }
+    base = hvf_get_reg(cpu, rn);
+    if (base + (preindex ? (int64_t)offset : 0) != va) {
+        return false;
+    }
+    value = hvf_get_reg(cpu, rt);
+    stq_le_p(bytes, value);
+    if (address_space_write(as, ipa, MEMTXATTRS_UNSPECIFIED,
+                            bytes, length) != MEMTX_OK) {
+        error_report("HVF STR writeback bus rejected: pc=0x%" PRIx64
+                     " ipa=0x%" PRIx64, pc, ipa);
+        return false;
+    }
+    hvf_set_reg(cpu, rn, base + (int64_t)offset);
+    error_report("HVF STR writeback MMIO completed: cpu=%d pc=0x%" PRIx64
+                 " ipa=0x%" PRIx64, cpu->cpu_index, pc, ipa);
+    return true;
 }
 
