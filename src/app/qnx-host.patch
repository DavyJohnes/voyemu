+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Userspace fallback for platform-GIC accesses not decoded by Hypervisor. */
+#ifndef VOYEMU_HVF_GIC_MMIO_H
+#define VOYEMU_HVF_GIC_MMIO_H
+
+typedef enum HVFGICAccess {
+    HVF_GIC_UNKNOWN, HVF_GIC_RW, HVF_GIC_RO, HVF_GIC_WRITE_ONE,
+    HVF_GIC_RESERVED, HVF_GIC_RESERVED_NO_ESPI
+} HVFGICAccess;
+
+typedef struct HVFGICRegister {
+    unsigned width;
+    HVFGICAccess access;
+} HVFGICRegister;
+
+static HVFGICRegister hvf_gic_register(bool redist, uint32_t offset)
+{
+    uint32_t word = offset & ~3U;
+    if (redist) {
+        if (word == 8 || word == 12) {
+            return (HVFGICRegister){8, HVF_GIC_RO};
+        }
+        if (word == 0xffe8 || word == 0x10c00) {
+            return (HVFGICRegister){4, HVF_GIC_RO};
+        }
+        if (word == 0x10080 || word == 0x10c04 ||
+            (word >= 0x10400 && word <= 0x1041c)) {
+            return (HVFGICRegister){4, HVF_GIC_RW};
+        }
+        if (word == 0x10100 || word == 0x10180 ||
+            word == 0x10200 || word == 0x10280 ||
+            word == 0x10300 || word == 0x10380) {
+            return (HVFGICRegister){4, HVF_GIC_WRITE_ONE};
+        }
+        /* Security extensions are disabled for the HVF platform GIC. */
+        if (word == 0x10d00 || word == 0x10e00) {
+            return (HVFGICRegister){4, HVF_GIC_RESERVED};
+        }
+    } else {
+        if (word == 4 || word == 0xffe8) {
+            return (HVFGICRegister){4, HVF_GIC_RO};
+        }
+        if (word == 0 || (word >= 0x80 && word <= 0xfc) ||
+            (word >= 0x400 && word <= 0x7f8) ||
+            (word >= 0xc00 && word <= 0xcfc)) {
+            return (HVFGICRegister){4, HVF_GIC_RW};
+        }
+        if (word >= 0x100 && word <= 0x3fc) {
+            return (HVFGICRegister){4, HVF_GIC_WRITE_ONE};
+        }
+        if (word >= 0x6000 && word <= 0x60ff) {
+            return (HVFGICRegister){8, HVF_GIC_RESERVED};
+        }
+        if (word >= 0x6100 && word <= 0x7fdc) {
+            return (HVFGICRegister){8, HVF_GIC_RW};
+        }
+        if (word >= 0x7fe0 && word < 0xffd0) {
+            return (HVFGICRegister){8, HVF_GIC_RESERVED_NO_ESPI};
+        }
+        if (word == 0x7fc || (word >= 0x800 && word <= 0xbfc) ||
+            (word >= 0xd00 && word <= 0xdfc) ||
+            (word >= 0xe00 && word <= 0xefc) ||
+            (word >= 0xf10 && word <= 0xf3c)) {
+            return (HVFGICRegister){4, HVF_GIC_RESERVED};
+        }
+        if (word >= 0xffd0 && word <= 0xfffc) {
+            return (HVFGICRegister){4, HVF_GIC_RO};
+        }
+    }
+    return (HVFGICRegister){0, HVF_GIC_UNKNOWN};
+}
+
+typedef struct HVFGICMMIO {
+    bool redist, writing;
+    uint32_t offset;
+    unsigned length;
+    uint64_t value, expected_base;
+    MemTxResult result;
+} HVFGICMMIO;
+
+static hv_return_t hvf_gic_api_read(bool redist, hv_vcpu_t fd,
+                                  uint32_t offset, uint64_t *value)
+{
+    return redist ? hv_gic_get_redistributor_reg(fd, offset, value) :
+                    hv_gic_get_distributor_reg(offset, value);
+}
+
+static hv_return_t hvf_gic_api_write(bool redist, hv_vcpu_t fd,
+                                   uint32_t offset, uint64_t value)
+{
+    return redist ? hv_gic_set_redistributor_reg(fd, offset, value) :
+                    hv_gic_set_distributor_reg(offset, value);
+}
+
+static void hvf_gic_mmio_transfer(hv_vcpu_t fd, HVFGICMMIO *op)
+{
+    HVFGICRegister reg = hvf_gic_register(op->redist, op->offset);
+    uint32_t aligned;
+    unsigned shift;
+    uint64_t mask, current = 0, typer;
+
+    op->result = MEMTX_ERROR;
+    if (!reg.width || !op->length || op->length > reg.width ||
+        (op->length & (op->length - 1)) ||
+        (op->offset & (op->length - 1))) {
+        return;
+    }
+    aligned = op->offset & ~(reg.width - 1);
+    shift = (op->offset - aligned) * 8;
+    if (reg.access == HVF_GIC_RESERVED_NO_ESPI) {
+        if (hv_gic_get_distributor_reg(HV_GIC_DISTRIBUTOR_REG_GICD_TYPER,
+                                       &typer) != HV_SUCCESS ||
+            (typer & (1U << 8))) {
+            return;
+        }
+    }
+    if (reg.access == HVF_GIC_RESERVED ||
+        reg.access == HVF_GIC_RESERVED_NO_ESPI) {
+        op->value = 0;
+        op->result = MEMTX_OK;
+        return;
+    }
+    if (op->writing && reg.access == HVF_GIC_RO) {
+        op->result = MEMTX_OK;
+        return;
+    }
+    mask = op->length == 8 ? UINT64_MAX :
+           (UINT64_C(1) << (op->length * 8)) - 1;
+    if (!op->writing || (op->length != reg.width &&
+                        reg.access != HVF_GIC_WRITE_ONE)) {
+        if (hvf_gic_api_read(op->redist, fd, aligned, &current) != HV_SUCCESS) {
+            return;
+        }
+    }
+    if (op->writing) {
+        uint64_t value = (op->value & mask) << shift;
+        if (op->length != reg.width && reg.access != HVF_GIC_WRITE_ONE) {
+            value |= current & ~(mask << shift);
+        }
+        if (hvf_gic_api_write(op->redist, fd, aligned, value) != HV_SUCCESS) {
+            return;
+        }
+    } else {
+        op->value = (current >> shift) & mask;
+    }
+    op->result = MEMTX_OK;
+}
+
+/* Public redistributor APIs require the owning vCPU thread. */
+static void hvf_gic_mmio_on_cpu(CPUState *cpu, run_on_cpu_data data)
+{
+    static unsigned typer_logs;
+    HVFGICMMIO *op = data.host_ptr;
+    hv_ipa_t actual_base;
+    op->result = MEMTX_ERROR;
+    if (!cpu->accel ||
+        hv_gic_get_redistributor_base(cpu->accel->fd, &actual_base) != HV_SUCCESS ||
+        actual_base != op->expected_base) {
+        error_report("DEBUG HVF GIC owner/base rejected: expected=0x%" PRIx64
+                     " offset=0x%x", op->expected_base, op->offset);
+        return;
+    }
+    hvf_gic_mmio_transfer(cpu->accel->fd, op);
+    if (!op->writing && (op->offset == 8 || op->offset == 12) && typer_logs++ < 32) {
+        error_report("DEBUG HVF GIC TYPER fallback: fd=%llu base=0x%" PRIx64
+                     " offset=0x%x length=%u value=0x%" PRIx64 " result=%d",
+                     (unsigned long long)cpu->accel->fd, actual_base, op->offset,
+                     op->length, op->value, op->result);
+    }
+}
+
+static MemTxResult hvf_gic_dist_access(void *opaque, hwaddr offset,
+                                     uint64_t *value, unsigned length, bool writing)
+{
+    HVFGICMMIO op = {.offset = offset, .length = length,
+                     .value = *value, .writing = writing};
+    if (offset >= 0x10000) {
+        return MEMTX_ERROR;
+    }
+    hvf_gic_mmio_transfer(0, &op);
+    *value = op.value;
+    return op.result;
+}
+
+static MemTxResult hvf_gic_redist_access(void *opaque, hwaddr offset,
+                                       uint64_t *value, unsigned length, bool writing)
+{
+    GICv3RedistRegion *region = opaque;
+    GICv3State *s = region->gic;
+    SysBusDevice *bus = SYS_BUS_DEVICE(s);
+    size_t region_index = region - s->redist_regions;
+    uint32_t stride = gicv3_redist_size(s);
+    uint64_t local_index = offset / stride;
+    uint64_t index = region->cpuidx + local_index;
+    HVFGICMMIO op = {.redist = true, .writing = writing, .value = *value,
+                     .offset = offset % stride, .length = length,
+                     .expected_base = 0};
+    if (region_index >= s->nb_redist_regions || region_index + 1 >= bus->num_mmio ||
+        index >= s->num_cpu || !length || length > stride - op.offset) {
+        return MEMTX_ERROR;
+    }
+    op.expected_base = bus->mmio[region_index + 1].addr + local_index * stride;
+    run_on_cpu(s->cpu[index].cpu, hvf_gic_mmio_on_cpu, RUN_ON_CPU_HOST_PTR(&op));
+    *value = op.value;
+    return op.result;
+}
+
+#define HVF_GIC_CALLBACKS(name) \
+static MemTxResult hvf_gic_##name##_read(void *opaque, hwaddr offset, \
+                                        uint64_t *value, unsigned size, MemTxAttrs attrs) \
+{ return hvf_gic_##name##_access(opaque, offset, value, size, false); } \
+static MemTxResult hvf_gic_##name##_write(void *opaque, hwaddr offset, \
+                                         uint64_t value, unsigned size, MemTxAttrs attrs) \
+{ return hvf_gic_##name##_access(opaque, offset, &value, size, true); }
+HVF_GIC_CALLBACKS(dist)
+HVF_GIC_CALLBACKS(redist)
+#undef HVF_GIC_CALLBACKS
+
+static const MemoryRegionOps hvf_gic_mmio_ops[] = {
+    {.read_with_attrs = hvf_gic_dist_read, .write_with_attrs = hvf_gic_dist_write,
+     .endianness = DEVICE_LITTLE_ENDIAN, .valid.min_access_size = 1,
+     .valid.max_access_size = 8, .impl.min_access_size = 1, .impl.max_access_size = 8},
+    {.read_with_attrs = hvf_gic_redist_read, .write_with_attrs = hvf_gic_redist_write,
+     .endianness = DEVICE_LITTLE_ENDIAN, .valid.min_access_size = 1,
+     .valid.max_access_size = 8, .impl.min_access_size = 1, .impl.max_access_size = 8}
+};
+#endif
