# Exercises source selection in an owned temporary Git repository, without a commit.
# Usage: cmake -DWORK=<temporary parent> -P source_files.test.cmake
cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/source_files.cmake")
if(NOT WORK)
    message(FATAL_ERROR "WORK must name the temporary parent")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(repository "${WORK}/source files-${suffix}")
file(MAKE_DIRECTORY "${repository}/src" "${repository}/private")
function(voyemu_test_git)
    execute_process(COMMAND git ${ARGN} WORKING_DIRECTORY "${repository}"
        RESULT_VARIABLE result OUTPUT_QUIET)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Temporary Git command failed: ${ARGN}")
    endif()
endfunction()
voyemu_test_git(init --quiet)
file(WRITE "${repository}/src/Tracked.java" "class Tracked {}\n")
file(WRITE "${repository}/src/TrackedIgnored.java" "class TrackedIgnored {}\n")
file(WRITE "${repository}/src/Deleted.java" "class Deleted {}\n")
voyemu_test_git(add -- src/Tracked.java src/TrackedIgnored.java src/Deleted.java)
file(REMOVE "${repository}/src/Deleted.java")
file(WRITE "${repository}/src/New.java" "class New {}\n")
file(WRITE "${repository}/src/Ignored.java" "class Ignored {}\n")
file(WRITE "${repository}/src/Local.java" "class Local {}\n")
file(WRITE "${repository}/src/Other.cpp" "int other;\n")
file(WRITE "${repository}/private/Hidden.java" "class Hidden {}\n")
file(WRITE "${repository}/.gitignore" "src/Ignored.java\nsrc/TrackedIgnored.java\n/private/\n")
file(APPEND "${repository}/.git/info/exclude" "\nsrc/Local.java\n")
file(SHA256 "${repository}/.git/index" index_before)
voyemu_source_files(java "${repository}" "*.java")
list(SORT java)
set(expected_java src/New.java src/Tracked.java src/TrackedIgnored.java)
if(NOT java STREQUAL expected_java)
    message(FATAL_ERROR "Java selection: ${java}; expected: ${expected_java}")
endif()
voyemu_source_files(scoped "${repository}" src)
list(SORT scoped)
set(expected_scoped src/New.java src/Other.cpp src/Tracked.java src/TrackedIgnored.java)
if(NOT scoped STREQUAL expected_scoped)
    message(FATAL_ERROR "Root selection: ${scoped}; expected: ${expected_scoped}")
endif()
file(SHA256 "${repository}/.git/index" index_after)
if(NOT index_before STREQUAL index_after)
    message(FATAL_ERROR "Source selection changed the Git index")
endif()
file(REMOVE_RECURSE "${repository}")
message(STATUS "Source selection passed: tracked, deleted, new, ignored, local excludes and unchanged index")
